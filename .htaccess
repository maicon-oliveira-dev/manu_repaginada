# Regras locais do site legado.
# Não corresponde ao .htaccess atualmente gerenciado na hospedagem.
RewriteEngine On

# Normaliza a URL explícita da homepage legada.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect temporário da campanha sazonal de Páscoa.
RewriteRule ^pages/pascoa-2026\.html$ /pages/central-de-links.html [R=302,L]
