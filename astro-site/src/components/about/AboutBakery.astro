---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import bakeryAsset from '../../assets/about/manu-rosa-working.webp';
import Container from '../ui/Container.astro';

const bakeryImage: ImageMetadata = bakeryAsset;
---

<section class="about-bakery" aria-label="Manu Rosa Bakery">
  <Container size="wide">
    <div class="about-bakery__layout">
      <div class="about-bakery__copy">
        <p>
          Em <strong>2018</strong> engravidei do meu filho Noah e ao mesmo tempo, da minha própria confeitaria,
          a <strong>Manu Rosa Bakery</strong>! Foram 6 anos lindos adoçando a vida de muita gente. Na minha própria
          confeitaria tive espaço pra criar doces e bolos autorais, desenvolvendo minha criatividade em eventos
          incríveis como o <em>Harry Potter Day</em> e <em>Halloween</em>!
        </p>

        <p>
          Hoje, sou proprietária da <strong>Manu Rosa Bakery</strong>, onde preparamos bolos e doces e dou{' '}
          <strong>workshops e cursos</strong> na área da Confeitaria.
        </p>
      </div>

      <figure class="about-bakery__visual">
        <Picture
          class="about-bakery__image"
          pictureAttributes={{ class: 'about-bakery__picture' }}
          src={bakeryImage}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          width={1600}
          height={1068}
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(min-width: 40rem) 34rem, calc(100vw - 2rem)"
          alt="Chef Manu Rosa trabalhando na cozinha"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Container>
</section>

<style>
  .about-bakery {
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
    background: var(--color-background-soft);
  }

  .about-bakery__layout {
    display: grid;
    gap: clamp(var(--space-8), 4vw, var(--space-12));
  }

  .about-bakery__copy {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    align-items: start;
    gap: clamp(var(--space-5), 3vw, var(--space-8));
  }

  .about-bakery__copy p {
    padding: clamp(var(--space-5), 2.5vw, var(--space-6));
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-base), 1.15vw, var(--font-size-lg));
    line-height: 1.65;
    box-shadow: var(--shadow-sm);
  }

  .about-bakery strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .about-bakery em {
    color: var(--color-brand-active);
    font-family: var(--font-family-display);
    font-size: 1.08em;
    font-weight: var(--font-weight-semibold);
  }

  .about-bakery__visual {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .about-bakery__visual :global(.about-bakery__picture) {
    display: block;
    aspect-ratio: 1600 / 1068;
  }

  .about-bakery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 48rem) {
    .about-bakery__copy {
      grid-template-columns: 1fr;
    }
  }
</style>
