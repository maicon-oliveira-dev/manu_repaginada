---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import recognitionAsset from '../../assets/about/manu-rosa-que-seja-doce.jpg';
import Container from '../ui/Container.astro';

const recognitionImage: ImageMetadata = recognitionAsset;
---

<section class="about-recognition" aria-label="Reconhecimento no programa Que Seja Doce">
  <Container size="wide">
    <div class="about-recognition__layout">
      <div class="about-recognition__copy">
        <p>
          Em <strong>2016</strong> participei do programa <strong>“Que Seja Doce”</strong> no Canal GNT e{' '}
          <strong>ganhei o episódio chá de bebê</strong>! Foi uma grande emoção e superação pra mim! E uma divisão de
          águas na minha carreira como confeiteira!
        </p>
      </div>

      <figure class="about-recognition__visual">
        <Picture
          class="about-recognition__image"
          pictureAttributes={{ class: 'about-recognition__picture' }}
          src={recognitionImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={1067}
          height={1600}
          widths={[320, 480, 640, 800, 1067]}
          sizes="(min-width: 56.25rem) 27rem, (min-width: 40rem) 28rem, calc(100vw - 2rem)"
          alt="Chef Manu Rosa segurando o troféu do programa Que Seja Doce"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Container>
</section>

<style>
  .about-recognition {
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
    background: var(--color-surface);
  }

  .about-recognition__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 5vw, var(--space-16));
  }

  .about-recognition__copy {
    position: relative;
    max-width: 40rem;
    padding: clamp(var(--space-6), 3.5vw, var(--space-10));
    border-left: 0.25rem solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--color-accent-soft);
  }

  .about-recognition p {
    color: var(--color-text);
    font-family: var(--font-family-display);
    font-size: clamp(1.375rem, 1.8vw, 2rem);
    line-height: 1.4;
  }

  .about-recognition strong {
    color: var(--color-brand-active);
    font-weight: var(--font-weight-bold);
  }

  .about-recognition__visual {
    width: 100%;
    max-width: 22rem;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    background: var(--color-background-soft);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .about-recognition__visual :global(.about-recognition__picture) {
    display: block;
    aspect-ratio: 1067 / 1600;
  }

  .about-recognition__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 56.25rem) {
    .about-recognition__layout {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 22rem);
    }

    .about-recognition__visual {
      margin: 0;
    }
  }
</style>
