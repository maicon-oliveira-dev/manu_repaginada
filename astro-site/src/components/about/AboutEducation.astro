---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import educationAsset from '../../assets/about/manu-rosa-decorating.jpg';
import Container from '../ui/Container.astro';

const educationImage: ImageMetadata = educationAsset;
---

<section class="about-education" aria-label="Formação em confeitaria">
  <Container size="wide">
    <div class="about-education__layout">
      <figure class="about-education__visual">
        <Picture
          class="about-education__image"
          pictureAttributes={{ class: 'about-education__picture' }}
          src={educationImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={1067}
          height={1600}
          widths={[320, 480, 640, 800, 1067]}
          sizes="(min-width: 56.25rem) 28rem, (min-width: 40rem) 30rem, calc(100vw - 2rem)"
          alt="Chef Manu Rosa decorando um bolo"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="about-education__copy">
        <p>
          Sempre buscando conhecimento, fiz um <strong>curso de chef de cozinha em Curitiba-PR</strong> e tive a
          oportunidade de fazer uma <strong>especialização em Confeitaria na ENSP, na França</strong>! Realizei um sonho
          lindo e aprendi muito por lá! Quando retornei, passei a dar aulas e continuei com minhas encomendas! Nessa
          época, trabalhava muito com confeitaria artística e fazer doces e bolos bem decorados era a minha paixão!
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  .about-education {
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
    background:
      radial-gradient(circle at 12% 72%, var(--color-brand-soft), transparent 24rem),
      var(--color-background-soft);
  }

  .about-education__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 5vw, var(--space-16));
  }

  .about-education__visual {
    width: 100%;
    max-width: 25rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .about-education__visual :global(.about-education__picture) {
    display: block;
    aspect-ratio: 1067 / 1600;
  }

  .about-education__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-education__copy {
    max-width: 40rem;
    padding: clamp(var(--space-5), 3vw, var(--space-8));
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(255 253 251 / 0.92);
    box-shadow: var(--shadow-sm);
  }

  .about-education p {
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-base), 1.15vw, var(--font-size-lg));
    line-height: 1.65;
  }

  .about-education strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 56.25rem) {
    .about-education__layout {
      grid-template-columns: minmax(20rem, 25rem) minmax(0, 1fr);
    }

    .about-education__visual {
      margin: 0;
    }
  }
</style>
