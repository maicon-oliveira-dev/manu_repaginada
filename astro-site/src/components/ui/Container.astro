---
interface Props {
  as?: 'div' | 'section';
  size?: 'narrow' | 'content' | 'wide';
  class?: string;
}

const { as = 'div', size = 'content', class: className } = Astro.props;
const Tag = as;
---

<Tag class:list={['container', `container--${size}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .container--narrow {
    max-width: var(--container-narrow);
  }

  .container--content {
    max-width: var(--container-content);
  }

  .container--wide {
    max-width: var(--container-wide);
  }
</style>
