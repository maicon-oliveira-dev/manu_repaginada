---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import communityAsset from '../../assets/courses/turma-selfie-oficina.jpeg';
import Container from '../ui/Container.astro';

const communityImage: ImageMetadata = communityAsset;
---

<section class="courses-community" aria-labelledby="courses-community-title">
  <Container size="wide">
    <div class="courses-community__layout">
      <div class="courses-community__content">
        <span class="courses-community__eyebrow">Aprender com a turma</span>
        <h2 id="courses-community-title">Venha aprender com a gente</h2>
        <p>
          Receitas testadas, técnica consistente e uma experiência de aprendizado pensada para quem deseja evoluir de verdade na confeitaria.
        </p>
      </div>

      <figure class="courses-community__media">
        <Picture
          class="courses-community__image"
          pictureAttributes={{ class: 'courses-community__picture' }}
          src={communityImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={615}
          height={820}
          widths={[240, 320, 480, 615]}
          sizes="(min-width: 80rem) 32rem, (min-width: 56.25rem) 43vw, (min-width: 40rem) 34rem, calc(100vw - 2rem)"
          alt="Turma reunida em selfie durante oficina de confeitaria"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Container>
</section>

<style>
  .courses-community {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    border-top: 0.0625rem solid var(--color-border);
    background: var(--color-surface);
  }

  .courses-community__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 7vw, var(--space-20));
  }

  .courses-community__content {
    display: grid;
    max-width: 36rem;
    gap: var(--space-4);
  }

  .courses-community__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-community h2 {
    max-width: 12ch;
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-community__content p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .courses-community__media {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background-soft);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .courses-community__media :global(.courses-community__picture) {
    display: block;
    aspect-ratio: 3 / 4;
  }

  .courses-community__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 56.25rem) {
    .courses-community__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    }

    .courses-community__media {
      justify-self: end;
      margin: 0;
    }
  }

  @media (max-width: 39.99rem) {
    .courses-community {
      padding-block: var(--space-12);
    }

    .courses-community__content p {
      font-size: var(--font-size-base);
    }
  }
</style>
