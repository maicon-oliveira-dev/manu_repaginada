---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import certificateAsset from '../../assets/courses/aluna-com-certificado.jpeg';
import celebrationAsset from '../../assets/courses/turma-brinde.jpeg';
import Container from '../ui/Container.astro';

const celebrationImage: ImageMetadata = celebrationAsset;
const certificateImage: ImageMetadata = certificateAsset;
---

<section class="courses-gallery" aria-labelledby="courses-gallery-title">
  <Container size="wide">
    <header class="courses-gallery__heading">
      <span class="courses-gallery__eyebrow">Conquistas</span>
      <h2 id="courses-gallery-title">Aprendizado que gera memória, prática e conquista</h2>
      <p>
        Uma etapa que reúne turma, celebração e certificado para traduzir a experiência de evolução vivida em aula.
      </p>
    </header>

    <div class="courses-gallery__grid">
      <figure class="courses-gallery__figure courses-gallery__figure--primary">
        <Picture
          class="courses-gallery__image"
          pictureAttributes={{ class: 'courses-gallery__picture' }}
          src={celebrationImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={695}
          height={927}
          widths={[320, 480, 640, 695]}
          sizes="(min-width: 80rem) 34rem, (min-width: 56.25rem) 53vw, (min-width: 40rem) 60vw, calc(100vw - 2rem)"
          alt="Turma reunida brindando ao fim de um encontro"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="courses-gallery__figure courses-gallery__figure--secondary">
        <Picture
          class="courses-gallery__image"
          pictureAttributes={{ class: 'courses-gallery__picture' }}
          src={certificateImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={600}
          height={800}
          widths={[240, 320, 480, 600]}
          sizes="(min-width: 80rem) 22rem, (min-width: 56.25rem) 34vw, (min-width: 40rem) 36vw, 76vw"
          alt="Aluna com certificado de conclusão"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Container>
</section>

<style>
  .courses-gallery {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    background: var(--color-background-soft);
  }

  .courses-gallery__heading {
    display: grid;
    max-width: 52rem;
    gap: var(--space-3);
  }

  .courses-gallery__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-gallery h2 {
    max-width: 19ch;
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-gallery__heading p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .courses-gallery__grid {
    display: grid;
    min-width: 0;
    align-items: start;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    margin-top: var(--space-10);
  }

  .courses-gallery__figure {
    width: 100%;
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .courses-gallery__figure :global(.courses-gallery__picture) {
    display: block;
    aspect-ratio: 3 / 4;
  }

  .courses-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .courses-gallery__figure--secondary {
    width: 76%;
    margin-left: auto;
  }

  @media (min-width: 40rem) {
    .courses-gallery__grid {
      max-width: 58rem;
      grid-template-columns: minmax(0, 34rem) minmax(0, 22rem);
    }

    .courses-gallery__figure--secondary {
      width: 100%;
      margin-top: var(--space-16);
      margin-left: 0;
    }
  }

  @media (max-width: 39.99rem) {
    .courses-gallery {
      padding-block: var(--space-12);
    }

    .courses-gallery__heading p {
      font-size: var(--font-size-base);
    }
  }
</style>
