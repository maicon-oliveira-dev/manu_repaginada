---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import classGroupAsset from '../../assets/courses/turma-com-bolos.jpeg';
import Container from '../ui/Container.astro';

interface CourseModality {
  label: string;
  title: string;
  description: string;
}

const classGroupImage: ImageMetadata = classGroupAsset;
const modalities = [
  {
    label: 'Formação completa',
    title: 'Curso completo de Confeitaria',
    description:
      'Curso semestral completo, com mais de 30 aulas, pensado para habilitar a aluna a atuar como confeiteira profissional.',
  },
  {
    label: 'Aulas especiais',
    title: 'Workshops',
    description:
      'Aprenda receitas específicas e muito especiais, como bolos, cookies, brownies, cucas, pães, tortas salgadas, além de receitas sazonais para diferentes épocas do ano.',
  },
  {
    label: 'Formação presencial',
    title: 'Cursos presenciais para construir base e ganhar segurança',
    description:
      'Uma experiência de aprendizado feita para quem quer desenvolver técnica, entender os processos e confeitar com mais confiança, seja para casa ou para vender.',
  },
  {
    label: 'Consultoria prática',
    title: 'Cursos in company e desenvolvimento de cardápios e pratos',
    description:
      'Aprimore o cardápio do seu restaurante com receitas consagradas da Manu Rosa Bakery e uma leitura mais estratégica da produção.',
  },
] satisfies readonly CourseModality[];
---

<section id="cursos-modalidades" class="courses-modalities" aria-labelledby="courses-modalities-title">
  <Container size="wide">
    <header class="courses-modalities__heading">
      <span class="courses-modalities__eyebrow">Modalidades</span>
      <h2 id="courses-modalities-title">Um pouco dos cursos que oferecemos</h2>
      <p>
        As formações e experiências foram organizadas para atender quem quer aprender, se aperfeiçoar ou desenvolver novas possibilidades profissionais.
      </p>
    </header>

    <div class="courses-modalities__layout">
      <figure class="courses-modalities__feature">
        <Picture
          class="courses-modalities__image"
          pictureAttributes={{ class: 'courses-modalities__picture' }}
          src={classGroupImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={1613}
          height={1210}
          widths={[320, 480, 768, 960, 1200, 1440, 1613]}
          sizes="(min-width: 72rem) 31rem, (min-width: 64rem) 24rem, (min-width: 56rem) 52rem, (min-width: 40rem) calc(100vw - 4rem), calc(100vw - 2rem)"
          alt="Turma reunida com bolos produzidos em curso de confeitaria"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="courses-modalities__grid">
        {modalities.map((modality) => (
          <article class="courses-modalities__card">
            <span class="courses-modalities__label">{modality.label}</span>
            <h3>{modality.title}</h3>
            <p>{modality.description}</p>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  .courses-modalities {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    border-top: 0.0625rem solid var(--color-border);
    background: var(--color-background-soft);
  }

  .courses-modalities__heading {
    display: grid;
    max-width: 48rem;
    gap: var(--space-3);
  }

  .courses-modalities__eyebrow,
  .courses-modalities__label {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-modalities h2 {
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-modalities__heading p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .courses-modalities__layout {
    display: grid;
    gap: clamp(var(--space-8), 5vw, var(--space-12));
    margin-top: var(--space-10);
  }

  .courses-modalities__feature {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .courses-modalities__feature :global(.courses-modalities__picture) {
    display: block;
    aspect-ratio: 1613 / 1210;
  }

  .courses-modalities__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .courses-modalities__grid {
    display: grid;
    gap: var(--space-4);
  }

  .courses-modalities__card {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .courses-modalities__label {
    font-size: var(--font-size-xs);
  }

  .courses-modalities__card h3 {
    font-size: var(--font-size-xl);
    line-height: var(--line-height-heading);
  }

  .courses-modalities__card p {
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .courses-modalities__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .courses-modalities__layout {
      grid-template-columns: minmax(20rem, 24rem) minmax(0, 1fr);
      align-items: start;
    }

    .courses-modalities__feature {
      margin: 0;
    }
  }

  @media (min-width: 72rem) {
    .courses-modalities__layout {
      grid-template-columns: minmax(24rem, 31rem) minmax(0, 1fr);
    }
  }

  @media (max-width: 39.99rem) {
    .courses-modalities {
      padding-block: var(--space-12);
    }

    .courses-modalities__heading p {
      font-size: var(--font-size-base);
    }
  }
</style>
