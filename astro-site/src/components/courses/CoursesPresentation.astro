---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import manuPortraitAsset from '../../assets/courses/manu-rosa-retrato.jpeg';
import Container from '../ui/Container.astro';

const manuPortrait: ImageMetadata = manuPortraitAsset;
const whatsappHref =
  'https://api.whatsapp.com/send?phone=5547996552618&text=Ol%C3%A1%2C%20gostaria%20de%20saber%20mais%20sobre%20os%20cursos%20da%20Chef%20Manu%20Rosa.';
---

<section class="courses-presentation" aria-labelledby="courses-presentation-title">
  <Container size="wide">
    <div class="courses-presentation__layout">
      <figure class="courses-presentation__portrait">
        <Picture
          class="courses-presentation__image"
          pictureAttributes={{ class: 'courses-presentation__picture' }}
          src={manuPortrait}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={701}
          height={1050}
          widths={[320, 480, 600, 701]}
          sizes="(min-width: 40rem) 26rem, calc(100vw - 2rem)"
          alt="Retrato da Chef Manu Rosa"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="courses-presentation__content">
        <header class="courses-presentation__heading">
          <span class="courses-presentation__eyebrow">Apresentação</span>
          <h2 id="courses-presentation-title">Manu Rosa</h2>
        </header>

        <div class="courses-presentation__copy">
          <p>
            Olá, eu sou a <strong>Manu Rosa</strong>, chef confeiteira e proprietária da <strong>Manu Rosa Bakery</strong>.
          </p>
          <p>
            Sou formada chef de cozinha, com especialização em <strong>Pâtisserie</strong> na França. Também fui vencedora do programa <strong>Que Seja Doce</strong>, no canal <strong>GNT</strong>, e trabalho com doces desde 2006.
          </p>
          <p>
            Ao longo dessa trajetória, desenvolvi uma forma de ensinar que une técnica, proximidade e experiência real para quem deseja entrar ou evoluir no universo da confeitaria.
          </p>
        </div>

        <address class="courses-presentation__contacts">
          <a href="https://www.instagram.com/manurosabakery/" target="_blank" rel="noopener noreferrer">
            <span>Instagram:</span>
            <strong>@manurosabakery</strong>
          </a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp:</span>
            <strong>(47) 99655-2618</strong>
          </a>
        </address>
      </div>
    </div>
  </Container>
</section>

<style>
  .courses-presentation {
    padding-block: clamp(var(--space-12), 7vw, var(--space-20));
    background: var(--color-surface);
  }

  .courses-presentation__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
  }

  .courses-presentation__portrait {
    width: 100%;
    max-width: 26rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background-soft);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .courses-presentation__portrait :global(.courses-presentation__picture) {
    display: block;
    aspect-ratio: 701 / 1050;
  }

  .courses-presentation__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .courses-presentation__content {
    display: grid;
    max-width: 40rem;
    gap: var(--space-6);
  }

  .courses-presentation__heading {
    display: grid;
    gap: var(--space-2);
  }

  .courses-presentation__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-presentation h2 {
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-presentation__copy {
    display: grid;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .courses-presentation__copy strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .courses-presentation__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 0.0625rem solid var(--color-border);
    font-style: normal;
  }

  .courses-presentation__contacts a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-brand);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .courses-presentation__contacts a:hover {
    background: var(--color-brand-soft);
    color: var(--color-brand-hover);
  }

  .courses-presentation__contacts span {
    color: var(--color-text-muted);
  }

  .courses-presentation__contacts strong {
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 56.25rem) {
    .courses-presentation__layout {
      grid-template-columns: minmax(20rem, 26rem) minmax(0, 1fr);
    }

    .courses-presentation__portrait {
      justify-self: start;
      margin: 0;
    }
  }

  @media (max-width: 39.99rem) {
    .courses-presentation {
      padding-block: var(--space-12);
    }

    .courses-presentation__portrait {
      max-width: 24rem;
    }

    .courses-presentation__content {
      gap: var(--space-5);
    }

    .courses-presentation__copy {
      font-size: var(--font-size-base);
    }

    .courses-presentation__contacts {
      display: grid;
    }

    .courses-presentation__contacts a {
      width: 100%;
    }
  }
</style>
