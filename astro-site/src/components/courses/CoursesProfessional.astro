---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import cakeAsset from '../../assets/courses/bolo-frutas-vermelhas.jpeg';
import macaronsAsset from '../../assets/courses/macarons-profissionalizante.jpeg';
import temperingAsset from '../../assets/courses/temperagem-chocolate.jpeg';
import Container from '../ui/Container.astro';

const macaronsImage: ImageMetadata = macaronsAsset;
const cakeImage: ImageMetadata = cakeAsset;
const temperingImage: ImageMetadata = temperingAsset;

const highlights = [
  '9 aulas de bolos',
  'Tortas, doces finos e sobremesas',
  'Massa folhada e macarons',
  'Chocolates e temperagem',
  'Outras receitas incríveis',
] as const;
---

<section class="courses-professional" aria-labelledby="courses-professional-title">
  <Container size="wide">
    <header class="courses-professional__heading">
      <span class="courses-professional__eyebrow">Curso profissionalizante</span>
      <h2 id="courses-professional-title">Um pouco mais do meu curso profissionalizante de confeitaria</h2>
      <p>Confeitaria Francesa, Brasileira e Americana</p>
    </header>

    <div class="courses-professional__layout">
      <div class="courses-professional__gallery">
        <figure class="courses-professional__figure courses-professional__figure--main">
          <Picture
            class="courses-professional__image"
            pictureAttributes={{ class: 'courses-professional__picture' }}
            src={macaronsImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={340}
            height={455}
            widths={[180, 240, 320, 340]}
            sizes="(min-width: 80rem) 14rem, (min-width: 60rem) 18vw, (min-width: 40rem) 32vw, calc(100vw - 2rem)"
            alt="Macarons produzidos em curso profissionalizante"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="courses-professional__figure">
          <Picture
            class="courses-professional__image"
            pictureAttributes={{ class: 'courses-professional__picture' }}
            src={cakeImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={426}
            height={568}
            widths={[180, 240, 320, 426]}
            sizes="(min-width: 80rem) 11rem, (min-width: 60rem) 14vw, (min-width: 40rem) 27vw, 46vw"
            alt="Bolo com frutas vermelhas como exemplo de produção do curso"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="courses-professional__figure">
          <Picture
            class="courses-professional__image"
            pictureAttributes={{ class: 'courses-professional__picture' }}
            src={temperingImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={426}
            height={568}
            widths={[180, 240, 320, 426]}
            sizes="(min-width: 80rem) 11rem, (min-width: 60rem) 14vw, (min-width: 40rem) 27vw, 46vw"
            alt="Temperagem de chocolate em aula profissionalizante"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="courses-professional__content">
        <ul class="courses-professional__highlights" aria-label="Destaques do curso profissionalizante">
          {highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>

        <div class="courses-professional__information">
          <article>
            <h3>Conteúdo prático e técnico</h3>
            <ul>
              <li>Formação de custo e produto</li>
              <li>Boas práticas de fabricação</li>
              <li>Certificado de conclusão</li>
            </ul>
          </article>

          <article>
            <h3>Formato do curso</h3>
            <ul>
              <li>Aulas uma vez por semana</li>
              <li>8 meses de duração</li>
              <li>Horários matutino e noturno</li>
            </ul>
          </article>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .courses-professional {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    border-top: 0.0625rem solid var(--color-border);
    background: var(--color-background-soft);
  }

  .courses-professional__heading {
    display: grid;
    max-width: 58rem;
    gap: var(--space-3);
  }

  .courses-professional__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-professional h2 {
    max-width: 20ch;
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-professional__heading p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
  }

  .courses-professional__layout {
    display: grid;
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    margin-top: var(--space-10);
  }

  .courses-professional__gallery {
    display: grid;
    min-width: 0;
    grid-template-columns: 1.2fr 0.9fr 0.9fr;
    align-items: start;
    gap: var(--space-3);
  }

  .courses-professional__figure {
    width: 100%;
    margin: var(--space-8) 0 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .courses-professional__figure--main {
    margin-top: 0;
    border-radius: var(--radius-lg);
  }

  .courses-professional__figure :global(.courses-professional__picture) {
    display: block;
    aspect-ratio: 3 / 4;
  }

  .courses-professional__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .courses-professional__content {
    display: grid;
    align-content: start;
    gap: var(--space-8);
  }

  .courses-professional__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .courses-professional__highlights li {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: 0.0625rem solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .courses-professional__information {
    display: grid;
    gap: var(--space-6);
  }

  .courses-professional__information article {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 0.0625rem solid var(--color-border-strong);
  }

  .courses-professional__information h3 {
    font-size: var(--font-size-2xl);
  }

  .courses-professional__information ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-5);
    color: var(--color-text-muted);
  }

  @media (min-width: 60rem) {
    .courses-professional__layout {
      grid-template-columns: minmax(28rem, 1.12fr) minmax(22rem, 0.88fr);
      align-items: start;
    }
  }

  @media (min-width: 40rem) {
    .courses-professional__information {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .courses-professional {
      padding-block: var(--space-12);
    }

    .courses-professional__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .courses-professional__figure--main {
      grid-column: 1 / -1;
    }

    .courses-professional__figure:not(.courses-professional__figure--main) {
      margin-top: 0;
    }

    .courses-professional__heading p {
      font-size: var(--font-size-base);
    }
  }
</style>
