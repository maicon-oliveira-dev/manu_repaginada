---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import guestChefAsset from '../../assets/courses/chef-convidado-edu-bacon.jpeg';
import Container from '../ui/Container.astro';

const guestChefImage: ImageMetadata = guestChefAsset;
---

<section class="courses-guests" aria-labelledby="courses-guests-title">
  <Container size="wide">
    <div class="courses-guests__layout">
      <figure class="courses-guests__media">
        <Picture
          class="courses-guests__image"
          pictureAttributes={{ class: 'courses-guests__picture' }}
          src={guestChefImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={908}
          height={1210}
          widths={[320, 480, 640, 800, 908]}
          sizes="(min-width: 80rem) 29rem, (min-width: 56.25rem) 40vw, (min-width: 40rem) 34rem, calc(100vw - 2rem)"
          alt="Chef convidado Edu Bacon em aula especial"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="courses-guests__content">
        <span class="courses-guests__eyebrow">Aulas especiais</span>
        <h2 id="courses-guests-title">Aulas especiais com chefs convidados</h2>
        <p>
          Contamos também com chefs convidados para aulas especiais, ampliando o repertório, a vivência de mercado e a experiência de aprendizagem.
        </p>
        <div class="courses-guests__highlight">
          <strong>Master Chef Edu Bacon</strong>
          <span>Um dos convidados que somam conhecimento e novas perspectivas à formação.</span>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .courses-guests {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    border-top: 0.0625rem solid var(--color-border);
    background: var(--color-background-soft);
  }

  .courses-guests__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 6vw, var(--space-20));
  }

  .courses-guests__media {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .courses-guests__media :global(.courses-guests__picture) {
    display: block;
    aspect-ratio: 908 / 1210;
  }

  .courses-guests__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .courses-guests__content {
    display: grid;
    max-width: 38rem;
    gap: var(--space-4);
  }

  .courses-guests__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-guests h2 {
    max-width: 14ch;
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-guests__content > p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .courses-guests__highlight {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block: 0.0625rem solid var(--color-border-strong);
  }

  .courses-guests__highlight strong {
    color: var(--color-text);
    font-family: var(--font-family-display);
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-heading);
  }

  .courses-guests__highlight span {
    color: var(--color-text-muted);
  }

  @media (min-width: 56.25rem) {
    .courses-guests__layout {
      grid-template-columns: minmax(20rem, 29rem) minmax(0, 1fr);
    }

    .courses-guests__media {
      margin: 0;
    }
  }

  @media (max-width: 39.99rem) {
    .courses-guests {
      padding-block: var(--space-12);
    }

    .courses-guests__content > p {
      font-size: var(--font-size-base);
    }
  }
</style>
