---
import Container from '../ui/Container.astro';

interface RecognitionIndicator {
  value: string;
  label: string;
}

const indicators = [
  { value: 'Desde 2012', label: 'Atuação com aulas e workshops' },
  { value: '+800', label: 'Alunos formados' },
  { value: '+170', label: 'Trajetórias acompanhadas com resultados alcançados' },
  { value: '+10', label: 'Confeitarias abertas por alunos' },
  { value: '+100', label: 'Alunos que atuam como confeiteiros' },
] satisfies readonly RecognitionIndicator[];
---

<section class="courses-recognition" aria-labelledby="courses-recognition-title">
  <Container size="wide">
    <header class="courses-recognition__heading">
      <span class="courses-recognition__eyebrow">Reconhecimento</span>
      <h2 id="courses-recognition-title">Qualidade e reconhecimento garantido</h2>
      <p>
        Os indicadores abaixo foram organizados com base no material oficial para traduzir a consistência da trajetória da Manu na formação em confeitaria.
      </p>
    </header>

    <ul class="courses-recognition__indicators" aria-label="Indicadores dos cursos presenciais">
      {indicators.map((indicator) => (
        <li>
          <strong>{indicator.value}</strong>
          <span>{indicator.label}</span>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .courses-recognition {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-surface);
  }

  .courses-recognition__heading {
    display: grid;
    max-width: 52rem;
    gap: var(--space-3);
  }

  .courses-recognition__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .courses-recognition h2 {
    max-width: 18ch;
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
  }

  .courses-recognition__heading p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .courses-recognition__indicators {
    display: grid;
    gap: 0;
    margin: var(--space-12) 0 0;
    padding: 0;
    border-block: 0.0625rem solid var(--color-border-strong);
    list-style: none;
  }

  .courses-recognition__indicators li {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
  }

  .courses-recognition__indicators li + li {
    border-top: 0.0625rem solid var(--color-border);
  }

  .courses-recognition__indicators strong {
    color: var(--color-brand);
    font-family: var(--font-family-display);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
  }

  .courses-recognition__indicators span {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (min-width: 40rem) {
    .courses-recognition__indicators {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .courses-recognition__indicators li + li {
      border-top: 0;
    }

    .courses-recognition__indicators li:nth-child(even) {
      border-left: 0.0625rem solid var(--color-border);
    }

    .courses-recognition__indicators li:nth-child(n + 3) {
      border-top: 0.0625rem solid var(--color-border);
    }
  }

  @media (min-width: 70rem) {
    .courses-recognition__indicators {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .courses-recognition__indicators li + li {
      border-top: 0;
      border-left: 0.0625rem solid var(--color-border);
    }

    .courses-recognition__indicators li:nth-child(n + 3) {
      border-top: 0;
    }
  }

  @media (max-width: 39.99rem) {
    .courses-recognition {
      padding-block: var(--space-12);
    }

    .courses-recognition__heading p {
      font-size: var(--font-size-base);
    }

    .courses-recognition__indicators {
      margin-top: var(--space-8);
    }
  }
</style>
