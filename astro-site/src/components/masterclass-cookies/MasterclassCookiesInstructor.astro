---
import { Picture } from 'astro:assets'; import { masterclassCookies as content } from '../../data/masterclassCookies'; import manu from '../../assets/masterclass-cookies/manu-rosa.jpeg';
---
<section class="section" aria-labelledby="instructor-title"><div class="portrait"><Picture src={manu} formats={['avif','webp']} fallbackFormat="jpeg" widths={[640,960]} sizes="(max-width: 48rem) 100vw, 48vw" alt="Chef Manu Rosa segurando troféu do programa Que Seja Doce" loading="lazy" decoding="async" /></div><div><p>{content.instructor.eyebrow}</p><h2 id="instructor-title">{content.instructor.title}</h2><p>{content.instructor.copyOne}</p><p>{content.instructor.copyTwo}</p><p class="close">{content.instructor.close}</p></div></section>
<style>.section{padding:3.75rem max(1.25rem,calc((100% - 72rem)/2));background:var(--mc-cream);display:grid;gap:2rem;align-items:center}.portrait{width:100%;max-height:34rem;aspect-ratio:4/5;overflow:hidden;border-radius:1.5rem}.portrait :global(img){width:100%;height:100%;object-fit:cover;object-position:center 35%}.section div>p:first-child{font-size:.75rem;font-weight:700;letter-spacing:.14em;color:var(--mc-caramel)}.section h2{font:700 clamp(2rem,4vw,3.5rem)/1.05 var(--mc-display);margin:.5rem 0 1rem}.section div>p{max-width:58ch;margin-top:1rem}.close{font:700 1.3rem/1.2 var(--mc-display);color:var(--mc-caramel)}@media(min-width:48rem){.section{grid-template-columns:.48fr .52fr;gap:3rem}}@media(max-width:48rem){.portrait{max-width:28rem;margin:auto}}</style>
