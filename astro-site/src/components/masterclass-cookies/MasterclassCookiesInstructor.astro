---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section" aria-labelledby="instructor-title"><div class="photo" role="img" aria-label={`Área reservada para ${content.instructor.image}`}>TODO(cliente): substituir por {content.instructor.image}</div><div><p>{content.instructor.eyebrow}</p><h2 id="instructor-title">{content.instructor.title}</h2><p>{content.instructor.copyOne}</p><p>{content.instructor.copyTwo}</p><p class="close">{content.instructor.close}</p></div></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 68rem)/2));background:var(--mc-cream);display:grid;gap:2rem;align-items:center}.photo{aspect-ratio:4/5;background:var(--mc-peach);border-radius:2rem;display:grid;place-content:center;text-align:center;padding:1rem}.section p:first-child{font-size:.75rem;font-weight:700;letter-spacing:.08em;color:var(--mc-caramel);text-transform:uppercase}.section h2{font:700 clamp(2rem,5vw,3.8rem)/1 var(--mc-display);margin:.5rem 0 1.25rem}.close{font-weight:700}@media(min-width:48rem){.section{grid-template-columns:.9fr 1.1fr;gap:4rem}}</style>
