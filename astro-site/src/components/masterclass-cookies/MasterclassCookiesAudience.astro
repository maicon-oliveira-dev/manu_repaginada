---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section" aria-labelledby="audience-title"><div><p>{content.audience.eyebrow}</p><h2 id="audience-title">{content.audience.title}</h2><ul>{content.audience.items.map((item) => <li>{item}</li>)}</ul><p>{content.audience.close}</p></div><aside><p>{content.receive.eyebrow}</p><h3>{content.receive.title}</h3><ol>{content.receive.blocks.map((item, index) => <li><span>{index + 1}</span><div><strong>{item.title}</strong><p>{item.copy}</p></div></li>)}</ol></aside></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 68rem)/2));background:var(--mc-cream);display:grid;gap:2rem}.section>div>p:first-child,aside>p{font-size:.75rem;font-weight:700;letter-spacing:.08em;color:var(--mc-caramel);text-transform:uppercase}.section h2,.section h3{font:700 clamp(2rem,5vw,3.8rem)/1 var(--mc-display);margin:.5rem 0 1.5rem}.section h3{font-size:2rem}.section ul{padding:0;list-style:none}.section ul li{margin:.8rem 0}.section ul li::before{content:'✓';color:var(--mc-caramel);margin-right:.65rem;font-weight:700}aside{background:var(--mc-cocoa);color:var(--mc-cream);border-radius:1.5rem;padding:1.75rem}aside>p{color:var(--mc-beige)}aside ol{padding:0;list-style:none}aside li{display:flex;gap:.75rem;margin:1rem 0}aside span{color:var(--mc-beige);font-weight:700}aside strong{display:block}aside li p{font-size:.9rem;margin-top:.25rem}@media(min-width:48rem){.section{grid-template-columns:1.2fr .8fr;gap:4rem}}</style>
