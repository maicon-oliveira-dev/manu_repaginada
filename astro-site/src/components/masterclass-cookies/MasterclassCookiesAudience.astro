---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="audience" aria-labelledby="audience-title"><div class="for"><p>{content.audience.eyebrow}</p><h2 id="audience-title">{content.audience.title}</h2><ul>{content.audience.items.map((item) => <li>{item}</li>)}</ul><p class="close">{content.audience.close}</p></div><aside><p>{content.receive.eyebrow}</p><h3>{content.receive.title}</h3>{content.receive.blocks.map((item) => <div><strong>{item.title}</strong><span>{item.copy}</span></div>)}</aside></section>
<style>.audience{padding:4rem max(1.25rem,calc((100% - 72rem)/2));background:var(--mc-cream)}.for>p:first-child,aside>p{color:var(--mc-caramel);font-size:.75rem;font-weight:700;letter-spacing:.14em}.audience h2{font:700 clamp(2rem,4.5vw,3.5rem)/1.05 var(--mc-display);margin:.6rem 0 1.25rem}.for ul{list-style:none;padding:0;margin:0}.for li{padding:.45rem 0}.for li:before{content:'✓ ';color:var(--mc-caramel)}.close{font:700 1.3rem var(--mc-display);color:var(--mc-caramel);margin-top:1.5rem}aside{margin-top:2rem;padding:1.75rem;border-radius:1.5rem;background:var(--mc-beige)}aside h3{font:700 1.8rem var(--mc-display);margin:.6rem 0 1rem}aside div{margin-top:1rem}aside strong,aside span{display:block}aside span{font-size:.9rem;margin-top:.2rem}@media(min-width:48rem){.audience{display:grid;gap:3rem}.audience aside{margin:2rem 0 0}}</style>
