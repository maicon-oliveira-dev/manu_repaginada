---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="guarantee" aria-labelledby="guarantee-title"><div aria-hidden="true">♢</div><h2 id="guarantee-title">{content.guarantee.title}</h2><p>{content.guarantee.copy}</p></section>
<style>.guarantee{padding:3.5rem 1.25rem;text-align:center;background:var(--mc-peach)}.guarantee>div{font-size:2rem;color:var(--mc-cocoa)}.guarantee h2{font:700 clamp(1.8rem,4vw,3rem) var(--mc-display);margin:.7rem 0}.guarantee p{max-width:45rem;margin:auto}</style>
