---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="guarantee" aria-labelledby="guarantee-title"><div aria-hidden="true">✦</div><h2 id="guarantee-title">{content.guarantee.title}</h2><p>{content.guarantee.copy}</p></section><style>.guarantee{padding:4rem 1.25rem;text-align:center;background:var(--mc-peach)}.guarantee div{font-size:2rem;color:var(--mc-caramel)}h2{font:700 clamp(2rem,5vw,3.5rem)/1 var(--mc-display);margin:.5rem 0 1rem}.guarantee p{max-width:40rem;margin:auto}</style>
