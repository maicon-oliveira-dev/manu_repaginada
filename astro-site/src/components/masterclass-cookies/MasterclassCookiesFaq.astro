---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="faq" aria-labelledby="faq-title"><p>{content.faq.eyebrow}</p><h2 id="faq-title">{content.faq.title}</h2>{content.faq.items.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
<style>.faq{padding:4rem max(1.25rem,calc((100% - 52rem)/2));background:var(--mc-cream)}.faq>p{text-align:center;color:var(--mc-caramel);font-size:.75rem;font-weight:700;letter-spacing:.14em}.faq h2{text-align:center;font:700 clamp(2rem,4vw,3rem) var(--mc-display);margin:.5rem 0 1.75rem}details{border-top:1px solid #58230824;padding:1rem .5rem}details:last-child{border-bottom:1px solid #58230824}summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;font-weight:700;list-style:none}summary:after{content:'+';font-size:1.4rem;line-height:.8}details[open] summary:after{content:'×'}details p{margin:.75rem 0 0;max-width:44rem}</style>
