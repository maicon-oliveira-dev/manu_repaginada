---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section" aria-label="[AGUARDANDO TÍTULO DE DEPOIMENTOS]"><div>{content.testimonials.images.map((image) => <figure><div class="slot" role="img" aria-label={`Área reservada para ${image}`}>TODO(cliente): substituir por {image}</div></figure>)}</div></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 68rem)/2));background:var(--mc-beige)}.section>div{display:grid;gap:1rem}figure{margin:0;background:var(--mc-cream);border-radius:1.25rem;padding:1rem;box-shadow:0 .4rem 1rem #58230810}.slot{aspect-ratio:4/3;background:var(--mc-peach);border-radius:.75rem;display:grid;place-content:center;text-align:center;padding:1rem;font-size:.8rem;overflow:hidden}.slot :global(img){width:100%;height:100%;object-fit:contain}@media(min-width:48rem){.section>div{grid-template-columns:repeat(3,1fr)}}</style>
