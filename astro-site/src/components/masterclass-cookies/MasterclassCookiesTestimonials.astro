---
import { Picture } from 'astro:assets'; import { masterclassCookies as content } from '../../data/masterclassCookies'; import one from '../../assets/masterclass-cookies/depoimento-01.jpeg'; import two from '../../assets/masterclass-cookies/depoimento-02.jpeg'; import three from '../../assets/masterclass-cookies/depoimento-03.jpeg'; const images=[one,two,three];
---
<section class="section" aria-labelledby="testimonials-title"><p>{content.testimonials.eyebrow}</p><h2 id="testimonials-title">{content.testimonials.title}</h2><div class="grid">{images.map((image) => <figure><Picture src={image} formats={['avif','webp']} fallbackFormat="jpeg" widths={[480,720]} sizes="(max-width: 48rem) 92vw, 33vw" alt="Depoimento de aluna sobre aula de cookies da Manu Rosa" loading="lazy" decoding="async" /></figure>)}</div></section>
<style>.section{padding:3.5rem max(1.25rem,calc((100% - 72rem)/2));background-color:var(--mc-beige);background-image:radial-gradient(#58230820 .7px,transparent .7px);background-size:11px 11px}.section>p,.section h2{text-align:center}.section>p{font-size:.75rem;font-weight:700;letter-spacing:.14em;color:var(--mc-caramel)}.section h2{font:700 clamp(2rem,4vw,3rem) var(--mc-display);margin:.5rem 0 1.75rem}.grid{display:grid;gap:1rem;align-items:start}.grid figure{margin:0;padding:.45rem;background:var(--mc-cream);border-radius:.75rem;display:flex;justify-content:center}.grid figure :global(img){display:block;width:100%;max-height:30rem;object-fit:contain;object-position:top}@media(min-width:48rem){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:48rem){.grid figure{max-width:32rem;margin-inline:auto;width:100%}}</style>
