---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="bonus" aria-labelledby="bonus-title"><p>{content.bonus.kicker}</p><h2 id="bonus-title">{content.bonus.title}</h2><p>{content.bonus.copy}</p></section><style>.bonus{margin:4rem auto;padding:3rem 1.5rem;max-width:68rem;text-align:center;border:1px solid var(--mc-beige);border-radius:2rem;background:radial-gradient(var(--mc-beige) 1px,transparent 1px) 0 0/12px 12px}.bonus p:first-child{font-size:.75rem;font-weight:700;color:var(--mc-caramel);letter-spacing:.08em;text-transform:uppercase}.bonus h2{font:700 clamp(2rem,5vw,3.5rem)/1 var(--mc-display);margin:.5rem 0 1rem}.bonus>p:last-child{max-width:42rem;margin:auto}</style>
