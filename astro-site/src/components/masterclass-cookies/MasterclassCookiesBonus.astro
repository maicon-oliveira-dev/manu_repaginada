---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="bonus" aria-labelledby="bonus-title"><div aria-hidden="true">🎁</div><section><p class="kicker">{content.bonus.kicker}</p><h2 id="bonus-title">{content.bonus.title}</h2><p class="copy">{content.bonus.copy}</p><div class="period-note"><p>{content.bonus.periodNote}</p><p>{content.bonus.periodContinuation}</p></div></section></section>
<style>.bonus{padding:2.5rem max(1.25rem,calc((100% - 72rem)/2));background:var(--mc-peach);display:flex;gap:1.25rem;align-items:center}.bonus>div{display:grid;place-items:center;width:3.5rem;height:3.5rem;flex:none;border-radius:50%;background:var(--mc-cream);font-size:1.35rem}.bonus section{max-width:58rem}.bonus .kicker{font-size:.75rem;font-weight:700;letter-spacing:.14em}.bonus h2{font:700 clamp(1.65rem,3vw,2.5rem)/1.1 var(--mc-display);margin:.45rem 0}.bonus .copy{max-width:52rem}.period-note{max-width:52rem;margin-top:1rem;padding:.75rem 1rem;border-left:3px solid var(--mc-caramel);background:rgb(255 255 255 / .28);font-size:.9rem;line-height:1.4}.period-note p{margin:0}.period-note p+p{margin-top:.2rem}</style>
