---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="final" aria-labelledby="final-title"><h2 id="final-title">{content.final.title}</h2><p>{content.final.copy}</p><a href="#oferta">{content.final.cta}</a><small>[AGUARDANDO LINK DE CHECKOUT]</small></section><style>.final{padding:5rem 1.25rem;text-align:center;background:var(--mc-beige)}h2{font:700 clamp(2.2rem,6vw,4.5rem)/1 var(--mc-display);margin:0 auto 1rem;max-width:52rem}.final p{max-width:35rem;margin:0 auto 1.5rem}.final a{display:inline-block;background:var(--mc-cocoa);color:var(--mc-cream);padding:1rem 1.5rem;border-radius:99px;text-decoration:none;font-weight:700}.final small{display:block;margin-top:1rem;color:#58230899}</style>
