---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="hero" aria-labelledby="masterclass-title"><div class="inner"><div class="copy"><p class="kicker">{content.hero.kicker}</p><h1 id="masterclass-title">{content.hero.title}</h1><p class="lead">{content.hero.description}</p><div class="meta"><span>{content.hero.access}</span><span>{content.hero.duration}</span></div><a class="cta" href="#oferta">{content.hero.cta}</a><p class="price">{content.hero.price}<small>{content.hero.installments}</small></p></div><div class="media" role="img" aria-label={`Área reservada para ${content.hero.image}`}><span>TODO(cliente): substituir por {content.hero.image}</span><small>{content.hero.photoCaption}</small></div></div></section>
<style>.hero{background:var(--mc-cream);padding:4rem 0 5rem}.inner{max-width:72rem;margin:auto;padding:0 1.25rem;display:grid;gap:2.5rem;align-items:center}.kicker,.price{color:var(--mc-caramel);font-weight:700;letter-spacing:.08em;text-transform:uppercase}.kicker{font-size:.75rem}.hero h1{font:700 clamp(2.5rem,7vw,5.5rem)/.98 var(--mc-display);margin:.6rem 0 1.25rem}.lead{font-size:1.1rem;max-width:35rem}.meta{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.5rem 0}.meta span{border:1px solid var(--mc-beige);border-radius:99px;padding:.45rem .75rem;font-size:.85rem}.cta{display:inline-block;background:var(--mc-cocoa);color:var(--mc-cream);border-radius:99px;padding:1rem 1.5rem;text-decoration:none;font-weight:700;box-shadow:0 .5rem 1.25rem #58230830}.price{margin-top:1.25rem}.price small{display:block;color:var(--mc-cocoa);letter-spacing:0;text-transform:none;margin-top:.25rem}.media{aspect-ratio:4/5;background:var(--mc-peach);border-radius:2rem;display:grid;place-content:center;text-align:center;padding:2rem;box-shadow:0 1rem 2rem #58230814}.media small{margin-top:.75rem}@media(min-width:48rem){.inner{grid-template-columns:1.1fr .9fr;padding:0 2rem}.hero{padding:6rem 0}}</style>
