---
import { Picture } from 'astro:assets'; import { masterclassCookies as content } from '../../data/masterclassCookies'; import heroImage from '../../assets/masterclass-cookies/hero.jpeg'; import Button from '../ui/Button.astro';
const checkoutHref=content.offer.checkoutHref.trim(); const hasCheckout=checkoutHref.length>0; const purchaseHref=hasCheckout?checkoutHref:'#oferta';
---
<section class="hero" aria-labelledby="masterclass-title"><div class="inner"><div class="copy"><p class="kicker">{content.hero.kicker}</p><h1 id="masterclass-title">{content.hero.title}</h1><p class="lead">{content.hero.description}</p><div class="meta"><span>{content.hero.access}</span><span>{content.hero.duration}</span></div><div class="buy"><Button href={purchaseHref} external={hasCheckout} class="cta">{content.hero.cta}</Button><p class="price">{content.hero.price}<small>{content.hero.installments}</small></p></div></div><div class="media"><Picture src={heroImage} formats={['avif','webp']} fallbackFormat="jpeg" widths={[640,960,1280]} sizes="(max-width: 48rem) 100vw, 78rem" alt="Cookie recém-assado sobre grade de resfriamento" loading="eager" decoding="async" fetchpriority="high" /></div></div></section>
<style>.hero{background:var(--mc-cocoa);color:var(--mc-cream);padding:3.5rem 0}.inner{max-width:78rem;margin:auto;padding:0 1.25rem;display:grid;gap:2rem}.kicker{color:var(--mc-peach);font-size:.76rem;font-weight:700;letter-spacing:.14em}.hero h1{color:var(--mc-cream);font:700 clamp(2.5rem,6vw,4.4rem)/.98 var(--mc-display);margin:.75rem 0 1rem}.lead{max-width:33rem}.meta,.buy{display:flex;gap:1.25rem;flex-wrap:wrap;align-items:center}.meta{margin:1.5rem 0;font-size:.9rem;font-weight:700}.hero :global(.cta){background:var(--mc-peach);color:var(--mc-cocoa);border-radius:999px;padding:1rem 1.5rem}.price{margin:0;font:700 1.8rem var(--mc-display)}.price small{display:block;font:400 .82rem/1.35 'DM Sans';white-space:pre-line}.media{width:100%;max-height:32rem;aspect-ratio:16/9;overflow:hidden;border:1rem solid var(--mc-caramel);border-radius:1.5rem}.media :global(img){width:100%;height:100%;object-fit:cover;object-position:center 55%}@media(min-width:48rem){.hero{padding:4.5rem 0}.inner{padding:0 2rem}}@media(max-width:30rem){.hero{padding:3rem 0}.hero :global(.cta){width:100%}.media{max-height:22rem;aspect-ratio:4/3;border-width:.7rem}}</style>
