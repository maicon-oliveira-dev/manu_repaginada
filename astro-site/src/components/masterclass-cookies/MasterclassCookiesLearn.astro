---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section" aria-labelledby="learn-title"><p>{content.learn.eyebrow}</p><h2 id="learn-title">{content.learn.title}</h2><p>{content.learn.intro}</p><ol class="process">{content.learn.process.map((item, index) => <li><div class="photo" role="img" aria-label={`Área reservada para ${item.image}`}>TODO(cliente): {item.image}</div><b>0{index + 1}</b><strong>{item.label}</strong><small>{item.caption}</small></li>)}</ol><ul class="items">{content.learn.items.map((item) => <li>{item}</li>)}</ul></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 68rem)/2));background:var(--mc-peach)}.section>p:first-child{font-size:.75rem;font-weight:700;letter-spacing:.08em;color:var(--mc-caramel);text-transform:uppercase}.section h2{font:700 clamp(2rem,5vw,3.8rem)/1 var(--mc-display);margin:.5rem 0 1rem}.process,.items{padding:0;list-style:none;display:grid;gap:.75rem;margin:2rem 0}.process{grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}.process li{display:grid;gap:.6rem;background:var(--mc-cream);padding:1rem;border-radius:1rem}.photo{aspect-ratio:4/3;background:var(--mc-beige);border-radius:.75rem;display:grid;place-content:center;text-align:center;padding:1rem;font-size:.8rem}.process b{color:var(--mc-caramel);font:700 1.5rem var(--mc-display)}.process small{color:#582308bb}.items{grid-template-columns:repeat(auto-fit,minmax(13rem,1fr))}.items li{border-bottom:1px solid #58230830;padding:.75rem 0}.items li::before{content:'✦';color:var(--mc-caramel);margin-right:.5rem}</style>
