---
import { Picture } from 'astro:assets';
import { masterclassCookies as content } from '../../data/masterclassCookies';
import modeling from '../../assets/masterclass-cookies/processo-modelagem.jpeg';
import filling from '../../assets/masterclass-cookies/processo-recheio.jpeg';
import oven from '../../assets/masterclass-cookies/processo-forno-editorial.png';

const images = [modeling, filling, oven];
const alts = ['Manu Rosa demonstrando modelagem de cookies em aula', 'Mãos modelando porções de massa de cookie', 'Cookies sendo assados no forno'];
---

<section class="learn" aria-labelledby="learn-title">
  <p>{content.learn.eyebrow}</p>
  <h2 id="learn-title">{content.learn.title}</h2>
  <p class="intro">{content.learn.intro}</p>
  <ol class="process">
    {content.learn.process.map((item, index) => <li>
      <div class={`photo photo-${index + 1}`}>
        <Picture src={images[index]} formats={['avif', 'webp']} fallbackFormat="jpeg" widths={[400, 640]} sizes="(max-width: 48rem) 100vw, 33vw" alt={alts[index]} loading="lazy" decoding="async" />
      </div>
      <b>0{index + 1}</b>
      <strong>{item.label}</strong>
    </li>)}
  </ol>
  <ul class="items">{content.learn.items.map((item) => <li>{item}</li>)}</ul>
</section>

<style>
  .learn { padding: 3.5rem max(1.25rem, calc((100% - 72rem) / 2)); background: var(--mc-peach) }
  .learn > p:first-child { font-size: .75rem; font-weight: 700; letter-spacing: .14em; color: var(--mc-cocoa) }
  .learn h2 { font: 700 clamp(2rem, 4.5vw, 3.6rem)/1.05 var(--mc-display); max-width: 48rem; margin: .6rem 0 }
  .intro { max-width: 42rem }
  .process { padding: 0; margin: 2rem 0; display: grid; gap: 1rem; list-style: none }
  .process li { overflow: hidden; border-radius: 1rem; background: var(--mc-cream) }
  .photo { width: 100%; aspect-ratio: 4/3; overflow: hidden }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover }
  .photo-1 :global(img) { object-position: center 42% }
  .photo-2 :global(img) { object-position: center 48% }
  .photo-3 :global(img) { object-fit: cover; object-position: center }
  .process b, .process strong { display: block; padding: 0 1rem }
  .process b { color: var(--mc-caramel); font: 700 1.3rem var(--mc-display); margin-top: .75rem }
  .process strong { padding-bottom: 1rem }
  .items { margin: 0; padding: 1.5rem; list-style: none; background: var(--mc-cocoa); color: var(--mc-cream); border-radius: 1.5rem; display: grid; gap: .7rem }
  .items li::before { content: '✓ '; color: var(--mc-beige) }
  @media (min-width: 48rem) {
    .learn { padding-block: 4rem }
    .process { grid-template-columns: repeat(3, 1fr) }
    .items { grid-template-columns: 1fr 1fr; padding: 2rem }
  }
</style>
