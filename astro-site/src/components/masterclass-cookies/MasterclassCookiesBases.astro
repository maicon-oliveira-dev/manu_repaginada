---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section" aria-labelledby="bases-title"><p>{content.bases.eyebrow}</p><h2 id="bases-title">{content.bases.title}</h2><p class="subtitle">{content.bases.subtitle}</p><div class="cards">{content.bases.cookies.map((item) => <article><div class="photo" role="img" aria-label={`Área reservada para ${item.image}`}>TODO(cliente): substituir por {item.image}</div><p class="label">{item.label}</p><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div><blockquote>{content.bases.quote}</blockquote></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 68rem)/2));background:var(--mc-cream)}.section>p:first-child,.label{font-size:.75rem;font-weight:700;letter-spacing:.08em;color:var(--mc-caramel);text-transform:uppercase}.section h2{font:700 clamp(2rem,5vw,3.8rem)/1 var(--mc-display);margin:.5rem 0}.subtitle{max-width:38rem}.cards{display:grid;gap:1.5rem;margin-top:2rem}.cards article{padding:1rem;background:#fffdf8;border-radius:1.5rem;box-shadow:0 .5rem 1.5rem #58230812}.photo{aspect-ratio:16/10;background:var(--mc-peach);border-radius:1rem;display:grid;place-content:center;text-align:center;padding:1rem;font-size:.8rem}.label{margin-top:1rem}.cards h3{font:700 1.65rem var(--mc-display);margin:.3rem 0 .4rem}blockquote{margin:2rem 0 0;border-left:.25rem solid var(--mc-caramel);padding:.5rem 1rem;font:600 1.4rem var(--mc-display)}@media(min-width:48rem){.cards{grid-template-columns:1fr 1fr}}</style>
