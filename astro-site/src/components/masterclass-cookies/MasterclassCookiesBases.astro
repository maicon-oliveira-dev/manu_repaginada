---
import { Picture } from 'astro:assets';
import { masterclassCookies as content } from '../../data/masterclassCookies';
import traditional from '../../assets/masterclass-cookies/cookie-tradicional.jpeg';
import newYork from '../../assets/masterclass-cookies/cookie-new-york.jpeg';
const images=[traditional,newYork]; const alts=['Cookie tradicional servido ao lado de um copo de leite','Cookie New York recheado aberto mostrando o recheio'];
---
<section class="section" aria-labelledby="bases-title"><p>{content.bases.eyebrow}</p><h2 id="bases-title">{content.bases.title}</h2><p class="subtitle">{content.bases.subtitle}</p><div class="cards">{content.bases.cookies.map((item,index) => <article><div class={`photo photo-${index + 1}`}><Picture src={images[index]} formats={['avif','webp']} fallbackFormat="jpeg" widths={[480,720]} sizes="(max-width: 48rem) 100vw, 50vw" alt={alts[index]} loading="lazy" decoding="async" /></div><p class="label">{item.label}</p><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div><blockquote>{content.bases.quote}</blockquote></section><style>.section{padding:4rem max(1.25rem,calc((100% - 72rem)/2));background:var(--mc-cream);text-align:center}.section>p:first-child,.label{font-size:.75rem;font-weight:700;letter-spacing:.14em;color:var(--mc-caramel);text-transform:uppercase}.section h2{font:700 clamp(2rem,4.5vw,3.6rem)/1 var(--mc-display);margin:.5rem 0}.subtitle{max-width:42rem;margin:auto}.cards{display:grid;gap:1.25rem;margin-top:2rem;text-align:left}.cards article{padding:1.25rem;background:var(--mc-beige);border-radius:1.5rem}.cards article:nth-child(2){background:var(--mc-cocoa);color:var(--mc-cream)}.cards article:nth-child(2) h3{color:var(--mc-cream)}.photo{aspect-ratio:16/10;width:100%;overflow:hidden;border-radius:1rem}.photo :global(img){width:100%;height:100%;object-fit:cover;object-position:center 48%}.label{margin-top:1rem}.cards h3{font:700 1.8rem var(--mc-display);margin:.3rem 0 .4rem}blockquote{margin:2.5rem auto 0;color:var(--mc-caramel);font:700 1.4rem var(--mc-display);max-width:60rem}@media(min-width:48rem){.cards{grid-template-columns:1fr 1fr}}</style>
