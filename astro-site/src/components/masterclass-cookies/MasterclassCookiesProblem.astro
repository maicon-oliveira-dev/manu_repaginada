---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section problem" aria-labelledby="problem-title"><p>{content.problem.eyebrow}</p><h2 id="problem-title">{content.problem.title}</h2><div class="grid"><div><p>{content.problem.intro}</p><p class="close">{content.problem.close}</p></div><ul>{content.problem.pains.map((pain) => <li>{pain}</li>)}</ul></div></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 68rem)/2));background:var(--mc-beige)}.section>p{font-size:.75rem;font-weight:700;letter-spacing:.08em;color:var(--mc-caramel);text-transform:uppercase}.section h2{font:700 clamp(2rem,5vw,3.8rem)/1 var(--mc-display);margin:.5rem 0 2rem}.grid{display:grid;gap:1.5rem}.grid p{max-width:35rem}.close{font-weight:700}.grid ul{margin:0;padding:0;list-style:none;display:grid;gap:.75rem}.grid li{background:var(--mc-cream);border-radius:1rem;padding:1rem 1.25rem;box-shadow:0 .4rem 1rem #58230812}@media(min-width:48rem){.grid{grid-template-columns:1fr 1fr;gap:4rem}}</style>
