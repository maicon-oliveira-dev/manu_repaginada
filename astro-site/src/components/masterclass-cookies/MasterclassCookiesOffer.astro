---
import { masterclassCookies as content } from '../../data/masterclassCookies';
import Button from '../ui/Button.astro';
const checkoutHref = content.offer.checkoutHref.trim();
const hasCheckout = checkoutHref.length > 0;
const purchaseHref = hasCheckout ? checkoutHref : '#oferta';
---
<section class="offer" id="oferta" aria-labelledby="offer-title"><p>{content.offer.eyebrow}</p><h2 id="offer-title">{content.offer.title}</h2><div class="card"><div><h3>{content.offer.includesTitle}</h3><ul>{content.offer.items.map((item) => <li>{item}</li>)}</ul></div><div class="price"><span>{content.offer.priceLabel}</span><strong>{content.offer.price}</strong><small>{content.offer.installments}</small></div><Button href={purchaseHref} external={hasCheckout} class="purchase-cta">{content.offer.cta}</Button></div></section>
<style>.offer{padding:4rem max(1.25rem,calc((100% - 72rem)/2));background:var(--mc-cocoa);color:var(--mc-cream);text-align:center}.offer>p{font-size:.75rem;letter-spacing:.14em;font-weight:700;color:var(--mc-peach)}.offer h2{color:var(--mc-cream);font:700 clamp(2rem,4.5vw,3.5rem)/1.05 var(--mc-display);max-width:50rem;margin:.6rem auto 2rem}.card{background:var(--mc-cream);color:var(--mc-cocoa);border-radius:1.75rem;padding:1.5rem;text-align:left;display:grid;gap:1.5rem}.card h3{font:700 1.5rem var(--mc-display);margin:0 0 .75rem}.card ul{padding:0;margin:0;list-style:none}.card li{padding:.45rem 0}.card li:before{content:'✓ ';color:var(--mc-caramel)}.price{text-align:center;align-self:center}.price span{display:block;color:var(--mc-caramel);font-weight:700;letter-spacing:.12em;font-size:.75rem}.price strong{display:block;font:700 clamp(2.6rem,6vw,4rem) var(--mc-display)}.price small{white-space:pre-line;line-height:1.35}.card :global(.purchase-cta){grid-column:1/-1;width:100%;background:var(--mc-caramel);color:#fff;border-radius:999px;padding:1rem;font-weight:700}@media(min-width:48rem){.card{grid-template-columns:1.2fr .8fr;padding:2.25rem}.card :global(.purchase-cta){margin-top:.25rem}}</style>
