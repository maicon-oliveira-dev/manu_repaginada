---
import { masterclassCookies as content } from '../../data/masterclassCookies';
---
<section class="section" id="oferta" aria-labelledby="offer-title"><p>{content.offer.eyebrow}</p><h2 id="offer-title">{content.offer.title}</h2><h3>{content.offer.includesTitle}</h3><ul>{content.offer.items.map((item) => <li>{item}</li>)}</ul><div class="price"><span>{content.offer.priceLabel}</span><strong>{content.offer.price}</strong><small>{content.offer.installments}</small><a href="#oferta">{content.offer.cta}</a><em>{content.offer.checkoutHref || '[AGUARDANDO LINK REAL DE CHECKOUT]'}</em></div></section><style>.section{padding:4.5rem max(1.25rem,calc((100% - 48rem)/2));text-align:center;background:var(--mc-cocoa);color:var(--mc-cream)}.section>p{font-size:.75rem;font-weight:700;letter-spacing:.08em;color:var(--mc-beige);text-transform:uppercase}.section h2{font:700 clamp(2rem,5vw,3.8rem)/1 var(--mc-display);margin:.5rem 0 1.5rem}.section h3{font:700 1.2rem var(--mc-display);margin-bottom:1rem}.section ul{max-width:29rem;text-align:left;margin:0 auto 2rem;padding:0;list-style:none}.section li{padding:.6rem 0;border-bottom:1px solid #fff8ea35}.section li::before{content:'✦';color:var(--mc-beige);margin-right:.5rem}.price{max-width:27rem;margin:auto;padding:1.5rem;background:var(--mc-cream);color:var(--mc-cocoa);border-radius:1.5rem;display:grid;gap:.5rem}.price strong{font:700 2rem var(--mc-display)}.price a{margin-top:.75rem;background:var(--mc-caramel);color:#fff;text-decoration:none;border-radius:99px;padding:1rem;font-weight:700}.price em{font-size:.75rem;font-style:normal;color:#582308aa;overflow-wrap:anywhere}</style>
