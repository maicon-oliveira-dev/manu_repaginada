---
import Container from '../ui/Container.astro';

const questions = [
  {
    question: 'Como recebo o e-book?',
    answer:
      'Após a compra, o acesso ao PDF é imediato pelo e-mail informado no checkout.',
  },
  {
    question: 'É indicado para iniciantes?',
    answer: 'Sim! Receitas com medidas exatas, dicas de produção e acabamento.',
  },
  {
    question: 'Posso vender os biscoitos?',
    answer:
      'Esse é o objetivo! O material traz quantidades precisas, rendimento, embalagem e validade para você vender com segurança.',
  },
  {
    question: 'O bônus Cookie Box está incluso?',
    answer: 'Sim, o guia de Cookie Box de Natal já está incluso.',
  },
  {
    question: 'E se eu tiver problemas com o download?',
    answer:
      'Basta responder ao e-mail de confirmação; nossa equipe atende e resolve.',
  },
];
---

<section class="faq-section">
  <Container size="content">
    <div class="faq-list">
      {
        questions.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .faq-section {
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
    background: var(--color-background);
  }

  .faq-list {
    display: grid;
    width: min(100%, 52rem);
    gap: 0.875rem;
    margin: 0 auto;
  }

  .faq-item {
    overflow: clip;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .faq-item[open] {
    border-color: var(--color-brand);
  }

  summary {
    display: grid;
    min-height: 3.25rem;
    padding: var(--space-5) var(--space-6);
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    gap: var(--space-4);
    align-items: center;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.45vw + 0.92rem, 1.125rem);
    font-weight: 650;
    line-height: 1.45;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--duration-fast) var(--easing-standard);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    width: 0.75rem;
    height: 0.75rem;
    border-right: 0.125rem solid var(--color-brand);
    border-bottom: 0.125rem solid var(--color-brand);
    content: '';
    justify-self: center;
    transform: rotate(45deg) translate(-0.125rem, -0.125rem);
    transition: transform var(--duration-fast) var(--easing-standard);
  }

  summary:hover {
    background: var(--color-brand-soft);
  }

  .faq-item[open] summary::after {
    transform: rotate(225deg) translate(-0.125rem, -0.125rem);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6);
  }

  .faq-answer p {
    max-width: 64ch;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 0.35vw + 0.87rem, 1.0625rem);
    line-height: 1.65;
  }

  @media (max-width: 40rem) {
    .faq-section {
      padding-block: var(--space-12);
    }

    summary {
      padding: var(--space-4);
    }

    .faq-answer {
      padding: 0 var(--space-4) var(--space-5);
    }
  }
</style>
