---
import Container from '../ui/Container.astro';
---

<section class="faq-intro" aria-labelledby="faq-page-title">
  <Container size="content">
    <div class="faq-intro__content">
      <h1 id="faq-page-title">Perguntas frequentes</h1>
    </div>
  </Container>
</section>

<style>
  .faq-intro {
    padding-block: clamp(var(--space-16), 6vw, 5.5rem);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background-soft);
  }

  .faq-intro__content {
    width: min(100%, 52rem);
    margin-inline: auto;
  }

  h1 {
    max-width: 14ch;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  h1::before {
    display: block;
    width: 3rem;
    height: 0.1875rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    content: '';
  }

  @media (max-width: 40rem) {
    .faq-intro {
      padding-block: var(--space-12);
    }

    h1 {
      font-size: clamp(2.125rem, 10vw, 2.5rem);
    }
  }
</style>
