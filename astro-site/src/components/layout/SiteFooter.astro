---
import Container from '../ui/Container.astro';
import BrandMark from '../ui/BrandMark.astro';
import { mainNavigation } from '../../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container size="wide" class="site-footer__inner">
    <div class="site-footer__summary">
      <BrandMark
        class="site-footer__brand"
        variant="light"
        size="footer"
        href="/"
      />
      <p>Cursos, treinamentos e materiais educacionais de confeitaria.</p>
      <small>© {currentYear} Manu Rosa Cursos</small>
    </div>

    <nav aria-label="Navegação do rodapé">
      <ul class="site-footer__navigation">
        {mainNavigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 0.25rem solid var(--color-brand);
  background: var(--color-text);
  color: #ffffff;
  }

  .site-footer :global(.site-footer__inner) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: var(--space-10);
    padding-block: var(--space-12);
  }

  .site-footer__summary {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .site-footer :global(.site-footer__brand) {
    margin-bottom: var(--space-2);
  }
  
.site-footer__summary p {
  color: rgb(255 255 255 / 88%);
}

.site-footer__summary small {
  color: rgb(255 255 255 / 68%);
}

  .site-footer__navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

 .site-footer__navigation a {
  display: inline-flex;
  min-height: 2.75rem;
  align-items: center;
  color: rgb(255 255 255 / 88%);
  font-size: var(--font-size-sm);
  text-underline-offset: 0.2em;
}

  .site-footer__navigation a:hover {
  color: var(--color-brand);
}

  .site-footer__navigation a:focus-visible {
  outline: 0.125rem solid var(--color-brand);
  outline-offset: 0.25rem;
  border-radius: var(--radius-sm);
}

  @media (max-width: 44rem) {
    .site-footer :global(.site-footer__inner) {
      grid-template-columns: 1fr;
    }

    .site-footer__navigation {
      grid-template-columns: 1fr;
    }
  }
</style>
