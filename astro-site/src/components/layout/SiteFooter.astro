---
import Container from '../ui/Container.astro';
import { mainNavigation } from '../../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container size="wide" class="site-footer__inner">
    <div class="site-footer__summary">
      <strong>Manu Rosa Cursos</strong>
      <p>Estrutura em desenvolvimento. Conteúdo comercial ainda não publicado.</p>
      <small>© {currentYear} Manu Rosa Cursos</small>
    </div>

    <nav aria-label="Navegação estrutural do rodapé">
      <ul class="site-footer__navigation">
        {mainNavigation.map((item) => (
          <li>
            {item.available ? <a href={item.href}>{item.label}</a> : <span>{item.label} — estrutura futura</span>}
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 0.0625rem solid var(--color-border);
    background: var(--color-surface-elevated);
  }

  .site-footer :global(.site-footer__inner) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: var(--space-10);
    padding-block: var(--space-12);
  }

  .site-footer__summary {
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__summary strong {
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
  }

  .site-footer__summary p,
  .site-footer__summary small,
  .site-footer__navigation span {
    color: var(--color-text-muted);
  }

  .site-footer__navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__navigation a,
  .site-footer__navigation span {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: var(--font-size-sm);
  }

  @media (max-width: 44rem) {
    .site-footer :global(.site-footer__inner) {
      grid-template-columns: 1fr;
    }

    .site-footer__navigation {
      grid-template-columns: 1fr;
    }
  }
</style>
