---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import cookbookCoverAsset from '../../assets/ebooks/cookbook-cover.jpg';
import christmasCoverAsset from '../../assets/ebooks/christmas-ebook-cover.jpg';
import masterclassAsset from '../../assets/masterclass-cookies/hero.jpeg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

const cookbookCover: ImageMetadata = cookbookCoverAsset;
const christmasCover: ImageMetadata = christmasCoverAsset;
const masterclassImage: ImageMetadata = masterclassAsset;
---

<section class="ebooks-hero" aria-labelledby="ebooks-hero-title">
  <Container size="wide">
    <div class="ebooks-hero__layout">
      <div class="ebooks-hero__content">
        <p class="ebooks-hero__eyebrow">Agenda e digitais</p>
        <h1 id="ebooks-hero-title">Workshops &amp; E-books</h1>
        <p class="ebooks-hero__lead">Receitas testadas para vender, encantar a família e lotar sua agenda.</p>
        <p class="ebooks-hero__support">Receitas autorais, com acabamento premium e orientação direta da Manu.</p>
        <div class="ebooks-hero__actions">
          <Button href="#materiais-digitais" size="large">Conhecer os materiais</Button>
          <Button href="/cursos/" variant="secondary" size="large">Ver cursos e workshops</Button>
        </div>
      </div>

      <div class="ebooks-hero__visual" aria-label="Capas dos e-books e fotografia de confeitaria">
        <figure class="ebooks-hero__figure ebooks-hero__figure--cookbook">
          <Picture
            class="ebooks-hero__image"
            pictureAttributes={{ class: 'ebooks-hero__picture' }}
            src={cookbookCover}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={450}
            height={800}
            widths={[180, 260, 360, 450]}
            sizes="(min-width: 80rem) 12rem, (min-width: 56.25rem) 16vw, 8.75rem"
            alt="Capa do Cookbook Bolos Caseiros da Manu Rosa"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="ebooks-hero__figure ebooks-hero__figure--christmas">
          <Picture
            class="ebooks-hero__image"
            pictureAttributes={{ class: 'ebooks-hero__picture' }}
            src={christmasCover}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={480}
            height={720}
            widths={[220, 320, 420, 480]}
            sizes="(min-width: 80rem) 15rem, (min-width: 56.25rem) 20vw, 11rem"
            alt="Capa do E-book Biscoitos de Natal da Chef Manu Rosa"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
        <figure class="ebooks-hero__figure ebooks-hero__figure--workshop">
          <Picture
            class="ebooks-hero__image"
            pictureAttributes={{ class: 'ebooks-hero__picture' }}
            src={masterclassImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={960}
            height={600}
            widths={[240, 360, 520, 720]}
            sizes="(min-width: 56.25rem) 16rem, 48vw"
            alt="Cookies em primeiro plano, com uma assadeira ao fundo"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </Container>
</section>

<style>
  .ebooks-hero {
    padding-block: clamp(var(--space-10), 5vw, var(--space-16));
    border-bottom: 0.0625rem solid var(--color-border);
    background:
      radial-gradient(circle at 88% 15%, var(--color-accent-soft), transparent 25rem),
      linear-gradient(135deg, var(--color-brand-soft), var(--color-background-soft));
  }

  .ebooks-hero__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
  }

  .ebooks-hero__content {
    display: grid;
    max-width: 42rem;
    gap: var(--space-4);
  }

  .ebooks-hero__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ebooks-hero h1 {
    max-width: 11ch;
    font-size: var(--font-size-5xl);
  }

  .ebooks-hero__lead {
    color: var(--color-text);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
  }

  .ebooks-hero__support {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .ebooks-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .ebooks-hero__visual {
    display: grid;
    width: 100%;
    max-width: 38rem;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    grid-template-rows: auto auto;
    align-items: end;
    margin-inline: auto;
  }

  .ebooks-hero__figure {
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .ebooks-hero__figure :global(.ebooks-hero__picture) {
    display: block;
    height: 100%;
  }

  .ebooks-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ebooks-hero__figure--cookbook {
    z-index: 2;
    grid-area: 1 / 1 / 3 / 4;
    border-radius: var(--radius-md);
    transform: rotate(-2deg);
  }

  .ebooks-hero__figure--cookbook :global(.ebooks-hero__picture) {
    aspect-ratio: 9 / 16;
  }

  .ebooks-hero__figure--christmas {
    z-index: 3;
    grid-area: 1 / 3 / 3 / 7;
    border-radius: var(--radius-lg);
    transform: translateY(var(--space-3));
  }

  .ebooks-hero__figure--christmas :global(.ebooks-hero__picture) {
    aspect-ratio: 2 / 3;
  }

  .ebooks-hero__figure--workshop {
    z-index: 1;
    grid-area: 2 / 6 / 3 / 9;
    border-radius: var(--radius-md);
  }

  .ebooks-hero__figure--workshop :global(.ebooks-hero__picture) {
    aspect-ratio: 3 / 2;
  }

  .ebooks-hero__figure--workshop .ebooks-hero__image {
    object-position: center 58%;
  }

  @media (min-width: 56.25rem) {
    .ebooks-hero__layout {
      grid-template-columns: minmax(0, 0.92fr) minmax(30rem, 1.08fr);
    }
  }

  @media (max-width: 39.99rem) {
    .ebooks-hero {
      padding-block: var(--space-8) var(--space-12);
    }

    .ebooks-hero__lead,
    .ebooks-hero__support {
      font-size: var(--font-size-base);
    }

    .ebooks-hero__actions {
      display: grid;
    }

    .ebooks-hero__visual {
      max-width: 28rem;
    }
  }
</style>
