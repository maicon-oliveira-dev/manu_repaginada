---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import authorAsset from '../../assets/ebooks/manu-rosa-author.jpg';
import Container from '../ui/Container.astro';

const authorImage: ImageMetadata = authorAsset;
---

<section class="christmas-author" aria-labelledby="christmas-author-title">
  <Container size="wide">
    <div class="christmas-author__layout">
      <figure class="christmas-author__media">
        <Picture
          class="christmas-author__image"
          pictureAttributes={{ class: 'christmas-author__picture' }}
          src={authorImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={620}
          height={800}
          widths={[280, 420, 540, 620]}
          sizes="(min-width: 80rem) 24rem, (min-width: 56.25rem) 36vw, calc(100vw - 2rem)"
          alt="Retrato da Chef Manu Rosa em seu espaço de confeitaria"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="christmas-author__content">
        <p class="christmas-author__eyebrow">Sobre a autora</p>
        <h2 id="christmas-author-title">Manu Rosa</h2>
        <p>Olá, eu sou a <strong>Manu Rosa</strong>, chef confeiteira e proprietária da <strong>Manu Rosa Bakery</strong>.</p>
        <p>Sou formada chef de cozinha, com especialização em <strong>Pâtisserie</strong> na França. Também fui vencedora do programa <strong>Que Seja Doce</strong>, no canal <strong>GNT</strong>, e trabalho com doces desde 2006.</p>
        <p>Ao longo dessa trajetória, desenvolvi uma forma de ensinar que une técnica, proximidade e experiência real para quem deseja entrar ou evoluir no universo da confeitaria.</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .christmas-author {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20));
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-background-soft);
  }

  .christmas-author__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 7vw, var(--space-20));
  }

  .christmas-author__media {
    width: 100%;
    max-width: 28rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .christmas-author__media :global(.christmas-author__picture) {
    display: block;
    aspect-ratio: 3 / 4;
  }

  .christmas-author__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .christmas-author__content {
    display: grid;
    max-width: 42rem;
    gap: var(--space-4);
  }

  .christmas-author__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .christmas-author h2 {
    font-size: var(--font-size-4xl);
  }

  .christmas-author__content > p:not(.christmas-author__eyebrow) {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .christmas-author strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 56.25rem) {
    .christmas-author__layout {
      grid-template-columns: minmax(20rem, 0.82fr) minmax(0, 1.18fr);
    }
  }

  @media (max-width: 39.99rem) {
    .christmas-author {
      padding-block: var(--space-12);
    }

    .christmas-author__content > p:not(.christmas-author__eyebrow) {
      font-size: var(--font-size-base);
    }
  }
</style>
