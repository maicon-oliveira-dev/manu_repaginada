---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import cookieBoxAsset from '../../assets/ebooks/cookie-box.webp';
import Container from '../ui/Container.astro';

const cookieBoxImage: ImageMetadata = cookieBoxAsset;
---

<section class="christmas-bonus" aria-labelledby="christmas-bonus-title">
  <Container size="wide">
    <div class="christmas-bonus__layout">
      <div class="christmas-bonus__content">
        <p class="christmas-bonus__eyebrow">Conteúdo complementar</p>
        <h2 id="christmas-bonus-title">Bônus Exclusivo: Como montar sua Cookie Box de Natal!</h2>
        <p>Dicas de combinação de sabores. Ideias para presentear e vender mais. Dicas para não errar na sua produção natalina.</p>
        <p class="christmas-bonus__note">Conteúdo apresentado na página original do material.</p>
      </div>

      <figure class="christmas-bonus__media">
        <Picture
          class="christmas-bonus__image"
          pictureAttributes={{ class: 'christmas-bonus__picture' }}
          src={cookieBoxImage}
          formats={['avif']}
          fallbackFormat="webp"
          width={700}
          height={934}
          widths={[280, 420, 560, 700]}
          sizes="(min-width: 80rem) 25rem, (min-width: 56.25rem) 38vw, calc(100vw - 2rem)"
          alt="Caixa com biscoitos natalinos decorados e etiqueta da Manu Rosa"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </Container>
</section>

<style>
  .christmas-bonus {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20));
    background: var(--color-surface);
  }

  .christmas-bonus__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 7vw, var(--space-20));
  }

  .christmas-bonus__content {
    display: grid;
    max-width: 42rem;
    gap: var(--space-4);
  }

  .christmas-bonus__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .christmas-bonus h2 {
    max-width: 18ch;
    font-size: var(--font-size-4xl);
  }

  .christmas-bonus__content > p:not(.christmas-bonus__eyebrow) {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .christmas-bonus__note {
    width: fit-content;
    padding: var(--space-3) var(--space-4);
    border-left: 0.1875rem solid var(--color-accent);
    background: var(--color-background-soft);
    font-size: var(--font-size-sm) !important;
    font-weight: var(--font-weight-semibold);
  }

  .christmas-bonus__media {
    width: 100%;
    max-width: 30rem;
    margin: 0 auto;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background-soft);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .christmas-bonus__media :global(.christmas-bonus__picture) {
    display: block;
    aspect-ratio: 3 / 4;
  }

  .christmas-bonus__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 56.25rem) {
    .christmas-bonus__layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
    }
  }

  @media (max-width: 39.99rem) {
    .christmas-bonus {
      padding-block: var(--space-12);
    }

    .christmas-bonus__content > p:not(.christmas-bonus__eyebrow) {
      font-size: var(--font-size-base);
    }
  }
</style>
