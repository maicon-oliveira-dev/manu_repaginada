---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import butterAsset from '../../assets/ebooks/christmas-butter-cookies.jpg';
import chocolateAsset from '../../assets/ebooks/christmas-chocolate-stars.jpg';
import gingerbreadAsset from '../../assets/ebooks/christmas-gingerbread-cookies.jpg';
import linzerAsset from '../../assets/ebooks/christmas-linzer-cookies.jpg';
import Container from '../ui/Container.astro';

const gallery = [
  { image: butterAsset, alt: 'Biscoitos amanteigados com geleia sobre tapete de forno', width: 640, height: 640 },
  { image: gingerbreadAsset, alt: 'Biscoitos de especiarias em formatos natalinos sobre travessa vermelha', width: 640, height: 640 },
  { image: linzerAsset, alt: 'Biscoitos Linzer recheados com geleia sobre uma mesa', width: 640, height: 640 },
  { image: chocolateAsset, alt: 'Biscoitos em formato de estrela cobertos com chocolate sobre grade', width: 479, height: 640 },
] satisfies readonly { image: ImageMetadata; alt: string; width: number; height: number }[];
---

<section class="christmas-gallery" aria-labelledby="christmas-gallery-title">
  <Container size="wide">
    <header class="christmas-gallery__heading">
      <p class="christmas-gallery__eyebrow">Receitas em detalhe</p>
      <h2 id="christmas-gallery-title">Biscoitos para produzir, presentear e vender</h2>
    </header>
    <div class="christmas-gallery__grid">
      {gallery.map((item, index) => (
        <figure class:list={['christmas-gallery__figure', { 'christmas-gallery__figure--portrait': index === 3 }]}>
          <Picture
            class="christmas-gallery__image"
            pictureAttributes={{ class: 'christmas-gallery__picture' }}
            src={item.image}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={item.width}
            height={item.height}
            widths={[240, 360, 480, item.width]}
            sizes="(min-width: 70rem) 18rem, (min-width: 40rem) 44vw, calc(100vw - 2rem)"
            alt={item.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </Container>
</section>

<style>
  .christmas-gallery {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20));
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-background-soft);
  }

  .christmas-gallery__heading {
    display: grid;
    max-width: 48rem;
    gap: var(--space-3);
  }

  .christmas-gallery__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .christmas-gallery h2 {
    max-width: 19ch;
    font-size: var(--font-size-4xl);
  }

  .christmas-gallery__grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .christmas-gallery__figure {
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .christmas-gallery__figure :global(.christmas-gallery__picture) {
    display: block;
    aspect-ratio: 1;
  }

  .christmas-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 40rem) {
    .christmas-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 70rem) {
    .christmas-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .christmas-gallery {
      padding-block: var(--space-12);
    }
  }
</style>
