---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import coverAsset from '../../assets/ebooks/christmas-ebook-cover.jpg';
import linzerAsset from '../../assets/ebooks/christmas-linzer-cookies.jpg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

const coverImage: ImageMetadata = coverAsset;
const linzerImage: ImageMetadata = linzerAsset;
const practicalItems = ['15 receitas', 'Medidas e rendimento', 'Forno e ponto', 'Armazenamento e embalagem'] as const;
---

<section class="christmas-feature" aria-labelledby="christmas-feature-title">
  <Container size="wide">
    <div class="christmas-feature__layout">
      <div class="christmas-feature__content">
        <p class="christmas-feature__eyebrow">Receitas testadas</p>
        <h2 id="christmas-feature-title">E-book Biscoitos de Natal da Chef Manu Rosa</h2>
        <p>Neste material reuni minhas receitas preferidas e testadas de biscoitos natalinos, fáceis de executar e perfeitas para presentear ou vender.</p>
        <p>Um conteúdo adequado também para iniciantes e para quem quer transformar o fim de ano em renda extra.</p>
        <ul class="christmas-feature__items">
          {practicalItems.map((item) => <li>{item}</li>)}
        </ul>
        <div class="christmas-feature__action">
          <Button href="/ebooks/biscoitos-de-natal/" size="large">Ver conteúdo do e-book</Button>
        </div>
      </div>

      <div class="christmas-feature__visual">
        <figure class="christmas-feature__cookies">
          <Picture
            class="christmas-feature__image"
            pictureAttributes={{ class: 'christmas-feature__picture' }}
            src={linzerImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={720}
            height={720}
            widths={[320, 480, 640, 720]}
            sizes="(min-width: 80rem) 28rem, (min-width: 56.25rem) 40vw, calc(100vw - 2rem)"
            alt="Biscoitos Linzer com geleia dispostos sobre uma mesa"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="christmas-feature__cover">
          <Picture
            class="christmas-feature__image"
            pictureAttributes={{ class: 'christmas-feature__picture' }}
            src={coverImage}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={360}
            height={540}
            widths={[180, 260, 360]}
            sizes="(min-width: 56.25rem) 10rem, 7rem"
            alt="Capa do E-book Biscoitos de Natal"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </Container>
</section>

<style>
  .christmas-feature {
    padding-block: clamp(var(--space-12), 8vw, var(--space-24));
    border-block: 0.0625rem solid var(--color-border);
    background: var(--color-background-soft);
  }

  .christmas-feature__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-8), 7vw, var(--space-20));
  }

  .christmas-feature__content {
    display: grid;
    max-width: 42rem;
    gap: var(--space-4);
  }

  .christmas-feature__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .christmas-feature h2 {
    max-width: 17ch;
    font-size: var(--font-size-4xl);
  }

  .christmas-feature__content > p:not(.christmas-feature__eyebrow) {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .christmas-feature__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .christmas-feature__items li {
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .christmas-feature__action {
    display: flex;
    padding-top: var(--space-3);
  }

  .christmas-feature__visual {
    position: relative;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
    padding-left: clamp(var(--space-8), 10vw, var(--space-16));
    padding-bottom: var(--space-8);
  }

  .christmas-feature__cookies,
  .christmas-feature__cover {
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .christmas-feature__cookies {
    border-radius: var(--radius-lg);
  }

  .christmas-feature__cookies :global(.christmas-feature__picture) {
    display: block;
    aspect-ratio: 1;
  }

  .christmas-feature__cover {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32%;
    border-radius: var(--radius-md);
    transform: rotate(-2deg);
  }

  .christmas-feature__cover :global(.christmas-feature__picture) {
    display: block;
    aspect-ratio: 2 / 3;
  }

  .christmas-feature__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .christmas-feature__cover .christmas-feature__image {
    object-fit: contain;
  }

  @media (min-width: 56.25rem) {
    .christmas-feature__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
    }

    .christmas-feature__content {
      order: 2;
    }

    .christmas-feature__visual {
      order: 1;
    }
  }

  @media (max-width: 39.99rem) {
    .christmas-feature {
      padding-block: var(--space-12);
    }

    .christmas-feature__content > p:not(.christmas-feature__eyebrow) {
      font-size: var(--font-size-base);
    }

    .christmas-feature__items {
      grid-template-columns: 1fr;
    }

    .christmas-feature__action {
      display: grid;
    }
  }
</style>
