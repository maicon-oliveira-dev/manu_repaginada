---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/home/manu-rosa-hero.jpg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Cta {
  label: string;
  href: string;
  external?: boolean;
  ariaLabel?: string;
}

interface Highlight {
  label: string;
  text: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  highlights?: Highlight[];
  primaryCta: Cta;
  secondaryCta: Cta;
}

const {
  eyebrow,
  title,
  description,
  highlights = [],
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <Container size="wide">
    <div class="home-hero__layout">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{eyebrow}</p>

        <h1 id="home-hero-title">{title}</h1>

        <p class="home-hero__description">{description}</p>

        {
          highlights.length > 0 && (
            <ul
              class="home-hero__highlights"
              aria-label="Destaques dos cursos"
            >
              {highlights.map((highlight) => (
                <li>
                  <strong>{highlight.label}</strong>
                  <span>{highlight.text}</span>
                </li>
              ))}
            </ul>
          )
        }

        <div class="home-hero__actions">
          <Button
            href={primaryCta.href}
            size="large"
            external={primaryCta.external}
            ariaLabel={primaryCta.ariaLabel}
          >
            {primaryCta.label}
          </Button>

          <Button
            href={secondaryCta.href}
            variant="secondary"
            size="large"
            external={secondaryCta.external}
            ariaLabel={secondaryCta.ariaLabel}
          >
            {secondaryCta.label}
          </Button>
        </div>
      </div>

      <figure class="home-hero__media">
        <Picture
          class="home-hero__image"
          pictureAttributes={{ class: 'home-hero__picture' }}
          src={heroImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={960}
          widths={[480, 640, 800, 960, 1152]}
          sizes="(min-width: 80rem) 36rem, (min-width: 56.25rem) 44vw, calc(100vw - 2rem)"
          alt="Manu Rosa preparando uma receita em seu espaço de confeitaria."
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />

        <figcaption>
          Vivências práticas com método e acabamento impecável.
        </figcaption>
      </figure>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 0.0625rem solid var(--color-border);
    background:
      radial-gradient(
        circle at 90% 10%,
        rgb(244 115 167 / 12%),
        transparent 26rem
      ),
      var(--color-brand-soft);
    padding-block: clamp(var(--space-10), 8vw, var(--space-16));
  }

  .home-hero::before {
    position: absolute;
    top: -12rem;
    right: -10rem;
    width: 28rem;
    height: 28rem;
    border: 0.0625rem solid rgb(182 145 81 / 18%);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .home-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    gap: clamp(var(--space-10), 6vw, var(--space-16));
  }

  .home-hero__content {
    display: grid;
    max-width: 42rem;
    gap: var(--space-5);
  }

  .home-hero__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 13ch;
    font-size: clamp(3rem, 6vw, 5.25rem);
    letter-spacing: -0.035em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .home-hero__description {
    max-width: 50ch;
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 2vw, var(--font-size-xl));
  }

  .home-hero__highlights {
    display: grid;
    gap: var(--space-3);
    max-width: 38rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__highlights li {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 0.125rem solid var(--color-accent);
  }

  .home-hero__highlights strong {
    color: var(--color-text);
    font-size: var(--font-size-base);
  }

  .home-hero__highlights span {
    color: var(--color-text-muted);
    line-height: var(--line-height-body);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .home-hero__media {
    width: 100%;
    min-width: 0;
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .home-hero__media :global(.home-hero__picture) {
    display: block;
    aspect-ratio: 4 / 5;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 51% 50%;
  }

  .home-hero figcaption {
    padding: var(--space-4) var(--space-5);
    border-top: 0.0625rem solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-align: center;
  }

  @media (min-width: 40rem) {
    .home-hero__media :global(.home-hero__picture) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 56.25rem) {
    .home-hero__layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    }

    .home-hero__content {
      justify-self: start;
    }

    .home-hero__media {
      justify-self: end;
    }
  }

  @media (max-width: 30rem) {
    .home-hero__actions {
      display: grid;
    }

    .home-hero__actions > :global(*) {
      width: 100%;
    }

    .home-hero h1 {
      font-size: clamp(2.75rem, 14vw, 3.75rem);
    }
  }
</style>