---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/home/manu-rosa-hero.jpg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryCta: {
    label: string;
    href: string;
  };
  secondaryCta: {
    label: string;
    href: string;
  };
}

const { eyebrow, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <Container size="wide">
    <div class="home-hero__layout">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{eyebrow}</p>
        <h1 id="home-hero-title">{title}</h1>
        <p class="home-hero__description">{description}</p>
        <div class="home-hero__actions">
          <Button href={primaryCta.href} size="large">{primaryCta.label}</Button>
          <Button href={secondaryCta.href} variant="secondary" size="large">
            {secondaryCta.label}
          </Button>
        </div>
      </div>

      <figure class="home-hero__media">
        <Picture
          class="home-hero__image"
          pictureAttributes={{ class: 'home-hero__picture' }}
          src={heroImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={960}
          widths={[480, 640, 800, 960, 1152]}
          sizes="(min-width: 80rem) 36rem, (min-width: 56.25rem) 44vw, calc(100vw - 2rem)"
          alt="Manu Rosa preparando uma receita em seu espaço de confeitaria."
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </div>
  </Container>
</section>

<style>
  .home-hero {
    border-bottom: 0.0625rem solid var(--color-border);
    background: var(--color-brand-soft);
    padding-block: var(--space-12);
  }

  .home-hero__layout {
    display: grid;
    align-items: center;
    gap: clamp(var(--space-10), 6vw, var(--space-16));
  }

  .home-hero__content {
    display: grid;
    max-width: 40rem;
    gap: var(--space-5);
  }

  .home-hero__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 14ch;
  }

  .home-hero__description {
    max-width: 58ch;
    color: var(--color-text-muted);
    font-size: var(--font-size-xl);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .home-hero__media {
    width: 100%;
    min-width: 0;
    margin: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .home-hero__media :global(.home-hero__picture) {
    display: block;
    aspect-ratio: 4 / 5;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 51% 50%;
  }

  @media (min-width: 40rem) {
    .home-hero__media :global(.home-hero__picture) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 56.25rem) {
    .home-hero__layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    }

    .home-hero__content {
      justify-self: start;
    }

    .home-hero__media {
      justify-self: end;
    }
  }

  @media (max-width: 30rem) {
    .home-hero__actions {
      display: grid;
    }
  }
</style>
