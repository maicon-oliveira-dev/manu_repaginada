---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
  linkLabel: string;
}

const { eyebrow, title, description, image, imageAlt, href, linkLabel } = Astro.props;
const responsiveWidths = image.width > 320 ? [320, image.width] : [image.width];
---

<article class="home-course-card">
  <div class="home-course-card__media">
    <Picture
      class="home-course-card__image"
      pictureAttributes={{ class: 'home-course-card__picture' }}
      src={image}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      width={image.width}
      widths={responsiveWidths}
      sizes="(min-width: 70rem) 22rem, (min-width: 44rem) calc(50vw - 3rem), calc(100vw - 2rem)"
      alt={imageAlt}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="home-course-card__content">
    {eyebrow && <p class="home-course-card__eyebrow">{eyebrow}</p>}
    <h3>{title}</h3>
    <p class="home-course-card__description">{description}</p>
    <div class="home-course-card__action">
      <Button href={href} variant="secondary">{linkLabel}</Button>
    </div>
  </div>
</article>

<style>
  .home-course-card {
    display: grid;
    min-width: 0;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .home-course-card__media {
    background: var(--color-surface-elevated);
    overflow: hidden;
  }

  .home-course-card__media :global(.home-course-card__picture) {
    display: block;
    aspect-ratio: 4 / 3;
  }

  .home-course-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }

  .home-course-card__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .home-course-card__eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    line-height: var(--line-height-heading);
    text-transform: uppercase;
  }

  .home-course-card h3 {
    font-size: var(--font-size-2xl);
  }

  .home-course-card__description {
    color: var(--color-text-muted);
  }

  .home-course-card__action {
    margin-top: auto;
    padding-top: var(--space-3);
  }
</style>
