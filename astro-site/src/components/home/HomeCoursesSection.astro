---
import macaronsImage from '../../assets/home/courses/macarons.jpeg';
import preparationImage from '../../assets/home/courses/preparo-massa.jpeg';
import temperingImage from '../../assets/home/courses/temperagem-chocolate.jpeg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import HomeCourseCard from './HomeCourseCard.astro';
---

<Section labelledby="home-courses-title" class="home-courses">
  <Container size="content">
    <SectionHeading
      id="home-courses-title"
      eyebrow="Cursos que oferecemos!"
      title="Curso de Confeitaria"
      description="Vivências práticas com método e acabamento impecável."
    />

    <div class="home-courses__grid">
      <HomeCourseCard
        title="Curso de Confeitaria"
        description="30 aulas que te habilitam a atuar como confeiteira profissional."
        image={temperingImage}
        imageAlt="Chocolate sendo trabalhado com uma espátula durante uma aula de confeitaria."
        href="/cursos/"
        linkLabel="Quero conhecer o curso"
      />

      <HomeCourseCard
        eyebrow="Curso presencial"
        title="Confeitaria Básica para aprender com base e segurança"
        description="Um curso pensado para quem começa do zero e quer avançar com clareza até um bolo recheado lindo e bem-feito."
        image={preparationImage}
        imageAlt="Massa sendo preparada em uma tigela durante uma aula de confeitaria."
        href="/cursos/"
        linkLabel="Quero conhecer o curso"
      />

      <HomeCourseCard
        eyebrow="Workshops"
        title="Aulas & Workshops especiais"
        description="Diversos workshops na área da Confeitaria. Aprenda receitas específicas e muito especiais como bolos, cookies, brownies, cucas, pães, tortas salgadas, além de receitas especiais para diferentes épocas do ano."
        image={macaronsImage}
        imageAlt="Macarons preparados durante uma experiência de confeitaria."
        href="/cursos/"
        linkLabel="Ver central de cursos"
      />
    </div>

    <div class="home-courses__action">
      <Button href="/cursos/" size="large">
        Ver central de cursos
      </Button>
    </div>
  </Container>
</Section>

<style>
  .home-courses__grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, 17rem), 1fr)
    );
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .home-courses__action {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  @media (min-width: 44rem) and (max-width: 58.375rem) {
    .home-courses__grid > :global(.home-course-card:last-child) {
      width: calc((100% - var(--space-5)) / 2);
      grid-column: 1 / -1;
      justify-self: center;
    }
  }

  @media (max-width: 30rem) {
    .home-courses__action > :global(*) {
      width: 100%;
    }
  }
</style>