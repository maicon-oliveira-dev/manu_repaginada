---
import Container from '../ui/Container.astro';
---

<section class="event-feature" aria-labelledby="event-feature-title"><Container size="content"><div class="event-feature__card"><div class="event-feature__content"><p class="event-feature__eyebrow"><span></span> ENCONTRO ONLINE E GRATUITO</p><p class="event-feature__edition">Edição especial 2026</p><h2 id="event-feature-title">Cookies: Além da Receita</h2><p class="event-feature__subtitle">O Natal pode ser o começo de novas oportunidades com cookies!</p><p class="event-feature__copy">Aprenda técnicas e descubra possibilidades para criar, aperfeiçoar e vender cookies.</p><a class="event-feature__cta" href="/campanhas/alem-da-receita-2026/index.html">Quero participar <span aria-hidden="true">→</span></a></div><div class="event-feature__gallery" aria-label="Manu Rosa ensinando o preparo de cookies"><img class="event-feature__image event-feature__image--main" src="/campanhas/alem-da-receita-2026/assets/images/manu-processo.jpeg" alt="Chef Manu Rosa finalizando cookies durante uma aula" loading="eager" /><img class="event-feature__image event-feature__image--detail" src="/campanhas/alem-da-receita-2026/assets/images/cookie-recheado.jpeg" alt="Cookie recheado finalizado" loading="lazy" /><div class="event-feature__note"><span>com a Chef</span><strong>Manu Rosa</strong></div></div></div></Container></section>

<style>
  .event-feature { padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(2.5rem, 6vw, 5rem); background: #fff8ee; }.event-feature__card { display: grid; overflow: hidden; border-radius: clamp(1.25rem, 2.5vw, 2rem); background: #432117; box-shadow: 0 1.25rem 3.75rem rgb(78 38 21 / 19%); }.event-feature__content { position: relative; display: grid; align-content: center; padding: clamp(2.25rem, 5.5vw, 5rem) clamp(1.5rem, 5vw, 4.5rem); color: #fff8ee; }.event-feature__content::after { position: absolute; right: clamp(1rem, 3vw, 2.5rem); bottom: 1.5rem; color: rgb(232 185 125 / 13%); font-family: var(--font-family-display); font-size: clamp(6rem, 12vw, 10rem); line-height: .6; content: '✦'; }.event-feature__eyebrow, .event-feature__edition, .event-feature__subtitle, .event-feature__copy { position: relative; z-index: 1; }.event-feature__eyebrow { display: flex; align-items: center; gap: .55rem; margin: 0 0 var(--space-5); color: #e9bd7e; font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); letter-spacing: .14em; }.event-feature__eyebrow span { width: 1.9rem; height: .0625rem; background: currentColor; }.event-feature__edition { margin: 0 0 var(--space-2); color: rgb(255 248 238 / 68%); font-size: var(--font-size-sm); }.event-feature h2 { margin: 0; color: #fff8ee; font-size: clamp(3.2rem, 6vw, 5.8rem); line-height: .78; letter-spacing: -.055em; }.event-feature__subtitle { margin: var(--space-3) 0 0; color: #efc782; font-family: var(--font-family-display); font-size: clamp(1.7rem, 3vw, 2.7rem); font-style: italic; line-height: 1; }.event-feature__copy { max-width: 38ch; margin: var(--space-6) 0 0; color: rgb(255 248 238 / 88%); font-size: var(--font-size-lg); line-height: 1.5; }.event-feature__cta { position: relative; z-index: 1; justify-self: start; margin-top: var(--space-8); padding: .9rem 1.3rem; border: .0625rem solid #e9bd7e; border-radius: var(--radius-pill); color: #fff8ee; font-weight: var(--font-weight-bold); text-decoration: none; transition: background var(--duration-base), color var(--duration-base), transform var(--duration-base); }.event-feature__cta span { margin-left: .65rem; font-size: 1.2em; }.event-feature__cta:hover { background: #e9bd7e; color: #432117; transform: translateY(-.125rem); }.event-feature__gallery { position: relative; min-height: 27rem; padding: 1rem 1rem 1rem 0; background: #e9bd7e; }.event-feature__image { display: block; object-fit: cover; box-shadow: var(--shadow-md); }.event-feature__image--main { width: 85%; height: 100%; min-height: 27rem; border-radius: 0 0 0 1.1rem; object-position: center center; }.event-feature__image--detail { position: absolute; right: 0; bottom: 1.25rem; width: 38%; aspect-ratio: .82; border: .45rem solid #fff8ee; border-radius: .9rem 0 0 .9rem; object-position: center; }.event-feature__note { position: absolute; top: 1.8rem; right: 1.25rem; margin: 0; color: #432117; font-family: var(--font-family-display); font-size: 1.25rem; line-height: .95; text-align: right; }.event-feature__note strong { font-size: 1.45rem; } @media (min-width: 48rem) { .event-feature__card { grid-template-columns: minmax(0, 1.05fr) minmax(22rem, .95fr); } } @media (max-width: 30rem) { .event-feature__gallery { min-height: 21rem; }.event-feature__image--main { min-height: 21rem; }.event-feature__copy { font-size: var(--font-size-base); } }
  /* Selo com contraste garantido sobre a fotografia e acabamento editorial. */
  .event-feature__note { display: grid; gap: .15rem; top: 1.25rem; right: 1rem; max-width: 11.5rem; padding: .85rem 1rem .9rem; border: .0625rem solid rgb(255 237 200 / 58%); border-radius: .75rem; background: linear-gradient(135deg, rgb(58 25 16 / 94%), rgb(80 37 22 / 88%)); box-shadow: 0 .75rem 1.5rem rgb(45 19 11 / 30%); color: #fff8ee; font-size: 1.05rem; line-height: 1.05; text-align: left; backdrop-filter: blur(.375rem); }
  .event-feature__note::before { width: 1.7rem; height: .0625rem; margin-bottom: .2rem; background: #e9bd7e; content: ''; }
  .event-feature__note span { color: rgb(255 248 238 / 80%); font-size: .9rem; letter-spacing: .04em; }.event-feature__note strong { color: #efc782; font-size: 1.55rem; line-height: .9; }
  @media (max-width: 30rem) { .event-feature__note { top: 1rem; right: .75rem; padding: .7rem .8rem; }.event-feature__note strong { font-size: 1.3rem; } }
</style>
