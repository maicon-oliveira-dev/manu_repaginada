---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
---

<BaseLayout
  title="Manu Rosa Cursos | Cursos e e-books de confeitaria"
  description="Estrutura institucional dedicada aos cursos, treinamentos e e-books de confeitaria da Manu Rosa."
>
  <Section tone="brand-soft" spacing="large" labelledby="hero-title">
    <Container size="content">
      <div class="hero__content">
        <p class="eyebrow">Confeitaria e educação</p>
        <h1 id="hero-title">Cursos e e-books de confeitaria com Manu Rosa</h1>
        <p class="hero__description">
          Uma nova experiência está sendo preparada para reunir conteúdos educacionais, cursos e materiais de confeitaria em um só lugar.
        </p>
        <div class="hero__actions" aria-label="Caminhos principais">
          <Button href="/cursos/" size="large">Conhecer os cursos</Button>
          <Button href="/ebooks/" variant="secondary" size="large">Ver os e-books</Button>
        </div>
      </div>
    </Container>
  </Section>

  <Section labelledby="caminhos-title">
    <Container size="content">
      <SectionHeading id="caminhos-title" title="Escolha como deseja aprender" />
      <div class="cards-grid">
        <Card title="Cursos" description="Área preparada para reunir cursos e treinamentos de confeitaria após a validação do conteúdo." href="/cursos/" />
        <Card title="E-books" description="Materiais digitais organizados para consulta e aquisição após a validação das ofertas." href="/ebooks/" />
        <Card title="Sobre a Manu" description="Conheça a trajetória profissional e a proposta educacional que orientarão esta nova fase." href="/sobre/" />
      </div>
    </Container>
  </Section>

  <Section tone="soft" labelledby="posicionamento-title">
    <Container size="content">
      <SectionHeading
        id="posicionamento-title"
        eyebrow="Nova fase"
        title="Um site dedicado exclusivamente ao ensino"
        description="A nova estrutura foi planejada para apresentar cursos, treinamentos e e-books com clareza, organização e uma jornada de navegação sem distrações."
      />
      <ul class="principles-list">
        <li>Informações organizadas</li>
        <li>Navegação simples</li>
        <li>Foco em produtos educacionais</li>
      </ul>
    </Container>
  </Section>

  <Section labelledby="validacao-title">
    <Container size="narrow">
      <SectionHeading
        id="validacao-title"
        title="Conteúdo em validação"
        description="Os detalhes de cada curso e e-book serão publicados após a confirmação das informações comerciais, acadêmicas e de atendimento."
      />
      <div class="section-actions">
        <Button href="/duvidas/">Entender a nova estrutura</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .hero__content {
    display: grid;
    max-width: var(--container-narrow);
    gap: var(--space-5);
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__description {
    color: var(--color-text-muted);
    font-size: var(--font-size-xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 30rem) {
    .hero__actions {
      display: grid;
    }
  }
</style>
